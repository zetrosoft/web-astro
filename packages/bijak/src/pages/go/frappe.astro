---
// packages/bijak/src/pages/go/frappe.astro
// Clean Redirector & Internal Click Tracker ke Frappe Cloud Official Partner (Referral)
const targetUrl = "https://cloud.frappe.io/dashboard/signup?referrer=d8b2ecbf";
---
<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mengarahkan ke Frappe Cloud Resmi...</title>
    <!-- Prevent indexing redirector URLs by Search Engines -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    
    <script is:inline define:vars={{ targetUrl }}>
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track', JSON.stringify({
            type: 'conversion',
            event_type: 'affiliate_frappe_cloud',
            source_path: document.referrer || '/go/frappe/',
            target_url: targetUrl,
            meta_info: 'direct_redirect_page'
          }));
        }
      } catch (e) {}
      // Instant Client-side Navigation
      window.location.replace(targetUrl);
    </script>
  </head>
  <body style="margin: 0; background-color: #0f172a; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh;">
    <div style="text-align: center; padding: 2rem; max-width: 440px;">
      <div style="width: 44px; height: 44px; border: 3px solid #0284c7; border-top-color: transparent; border-radius: 50%; margin: 0 auto 1.5rem auto; animation: spin 0.8s linear infinite;"></div>
      <h1 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 0.5rem 0; color: #ffffff;">Mengarahkan ke Frappe Cloud</h1>
      <p style="font-size: 0.85rem; color: #94a3b8; line-height: 1.5; margin: 0 0 1.25rem 0;">
        Menghubungkan ke platform cloud resmi Frappe Technologies untuk implementasi ERPNext &amp; Frappe Apps tanpa beban sysadmin...
      </p>
      <div style="background: rgba(2, 132, 199, 0.1); border: 1px solid rgba(2, 132, 199, 0.25); border-radius: 12px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
        <span style="font-size: 0.75rem; color: #cbd5e1;">Official Managed Cloud:</span>
        <div style="font-family: monospace; font-size: 0.95rem; font-weight: 700; color: #38bdf8; margin-top: 0.25rem;">cloud.frappe.io</div>
      </div>
      <a href={targetUrl} rel="noopener sponsored" style="font-size: 0.8rem; color: #38bdf8; text-decoration: underline;">
        Klik di sini jika peramban Anda tidak otomatis dialihkan
      </a>
    </div>
    <style>
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </body>
</html>
