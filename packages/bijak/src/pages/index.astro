---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdSenseUnit from '../components/AdSenseUnit.astro';
import HostingerBox from '../components/HostingerBox.astro';
import KusumaMapSpotlight from '../components/KusumaMapSpotlight.astro';
import SamkarsaIndustryRef from '../components/SamkarsaIndustryRef.astro';

// Dapatkan artikel blog dan urutkan berdasarkan tanggal rilis terbaru
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Ambil 1 artikel teratas sebagai Headline
const headlinePost = sortedPosts[0];

// Ambil 3 artikel berikutnya sebagai artikel pendukung headline
const subFeaturedPosts = sortedPosts.slice(1, 4);

// Ambil sisa artikel untuk ditaruh di daftar bawah
const remainingPosts = sortedPosts.slice(4);

// Kategori unik beserta jumlah artikelnya
const categories = [...new Set(posts.map(post => post.data.category))];

// Fetch repositori nyata dari GitHub API
let orgRepos = [];
try {
  const orgReposRes = await fetch(`https://api.github.com/orgs/bijaktechnology/repos?sort=updated&per_page=10`, {
    headers: { 'User-Agent': 'Astro-App-Build' }
  });
  if (orgReposRes.ok) {
    orgRepos = await orgReposRes.json();
  }
} catch (e) {
  // Silent fallback
}

// Fallback data jika API offline atau limit terlampaui
const fallbackRepos = [
  {
    name: "storaji",
    description: "Sistem manajemen inventaris (Inventory Management System) yang ringan, cepat, dan responsif untuk kebutuhan bisnis UMKM.",
    language: "Go",
    stargazers_count: 124,
    forks_count: 18,
    html_url: "https://github.com/bijaktechnology/storaji"
  },
  {
    name: "storaji-ui",
    description: "Antarmuka grafis desktop modern untuk aplikasi manajemen inventaris Storaji yang dikembangkan dengan Electron dan Angular.",
    language: "TypeScript",
    stargazers_count: 86,
    forks_count: 12,
    html_url: "https://github.com/bijaktechnology/storaji-ui"
  },
  {
    name: "speech-synthesis",
    description: "Mesin pengolah teks-ke-suara (Text-to-Speech handler) yang dikustomisasi khusus untuk Lumen Robot Friend.",
    language: "Python",
    stargazers_count: 45,
    forks_count: 8,
    html_url: "https://github.com/bijaktechnology/speech-synthesis"
  },
  {
    name: "WiFiManager",
    description: "Fork khusus pengelola koneksi WiFi mikrokontroler ESP8266 dengan portal penangkapan captive portal web yang dimodifikasi.",
    language: "C++",
    stargazers_count: 32,
    forks_count: 15,
    html_url: "https://github.com/bijaktechnology/WiFiManager"
  }
];

const reposToShow = orgRepos.length > 0 ? orgRepos : fallbackRepos;
---

<Layout title="Jurnal Teknologi, Enterprise ERP & Bisnis Ritel Independen">
  <!-- Section 1: Hero Bento Grid (Lead Story + Sub-featured) -->
  <section class="mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left 8 Cols: Lead Headline Card -->
      {headlinePost && (
        <div class="lg:col-span-8 group">
          <div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 text-white p-8 sm:p-12 shadow-xl transition-all">
            <div class="relative z-10 space-y-4">
              <div class="flex items-center gap-3">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-rose-600 text-white shadow-sm">
                  {headlinePost.data.category}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  Laporan Utama Redaksi
                </span>
              </div>

              <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-[1.2] group-hover:text-rose-400 transition-colors">
                <a href={`/blog/${headlinePost.id}`}>{headlinePost.data.title}</a>
              </h1>

              <p class="text-slate-300 text-base sm:text-lg leading-relaxed line-clamp-3">
                {headlinePost.data.description}
              </p>

              <div class="flex items-center gap-4 text-xs font-mono text-slate-400 pt-4 border-t border-slate-800">
                <span>Oleh <strong class="text-white">{headlinePost.data.author}</strong></span>
                <span>•</span>
                <span>{headlinePost.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span>•</span>
                <span class="text-rose-400 font-bold">Baca Selengkapnya &rarr;</span>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Right 4 Cols: Sub-featured Stories -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Sorotan Populer
          </span>
          <a href="/blog" class="text-xs font-bold text-rose-600 hover:underline">Semua &rarr;</a>
        </div>

        {subFeaturedPosts.map(post => (
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm hover:border-rose-400 transition-all group">
            <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2.5 py-1 rounded-md">
              {post.data.category}
            </span>
            <h3 class="font-bold text-sm sm:text-base text-slate-950 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors mt-2 mb-1.5 leading-snug">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="text-xs text-slate-700 dark:text-slate-300 line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Homepage Native In-Feed AdSense Banner -->
  <AdSenseUnit className="my-10" />

  <!-- Section 2: Two-Column Main Content & Editorial Sidebar -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    
    <!-- Left 8 Cols: Remaining Stories Grid -->
    <div class="lg:col-span-8 space-y-8">
      <div class="flex items-center justify-between pb-3 border-b border-slate-300/80 dark:border-slate-800">
        <h2 class="text-2xl font-extrabold text-slate-950 dark:text-white tracking-tight">
          Laporan Analisis &amp; Wawasan Terkini
        </h2>
        <span class="text-xs font-mono text-slate-600 dark:text-slate-400 font-semibold">{posts.length} Artikel Terbit</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {remainingPosts.map(post => (
          <article class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow group">
            <div class="space-y-3">
              <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md">
                {post.data.category}
              </span>
              <h3 class="font-bold text-base text-slate-950 dark:text-white leading-snug group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-slate-700 dark:text-slate-300 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="text-[11px] text-slate-600 dark:text-slate-400 pt-4 mt-4 border-t border-slate-200 dark:border-slate-800 font-mono flex justify-between items-center font-medium">
              <span>{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <span class="text-rose-600 font-bold group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </article>
        ))}
      </div>

      <!-- Ekosistem Spotlight: Toko Sembako Kusuma (Boyolali) & Samkarsa ERPNext -->
      <div class="space-y-6 pt-4">
        <KusumaMapSpotlight />
        <SamkarsaIndustryRef />
      </div>
    </div>

    <!-- Right 4 Cols: Sticky Sidebar Hub -->
    <aside class="lg:col-span-4 space-y-6 sticky top-24">
      
      <!-- Category Filter Pills Card -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm">
        <h4 class="text-sm font-extrabold text-slate-950 dark:text-white uppercase tracking-wider mb-4 pb-2 border-b border-slate-200 dark:border-slate-800">
          Rubrik &amp; Kategori Liputan
        </h4>
        <div class="flex flex-wrap gap-2">
          {categories.map(category => {
            const count = posts.filter(post => post.data.category === category).length;
            return (
              <a
                href={`/blog?category=${category}`}
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-300/80 dark:border-slate-700 hover:bg-rose-500 hover:text-white transition-all"
              >
                <span>{category}</span>
                <span class="text-[10px] opacity-75">({count})</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Hostinger Partner Sidebar Widget -->
      <HostingerBox variant="sidebar" />

      <!-- Sticky Sidebar AdSense Unit -->
      <AdSenseUnit format="rectangle" minHeight="min-h-[250px]" />
    </aside>
  </div>

  <!-- Section 3: Open-Source Engineering & Software Showcase -->
  <section class="pt-8 border-t border-slate-300/80 dark:border-slate-800">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-8">
      <div>
        <h3 class="text-2xl font-extrabold text-slate-950 dark:text-white tracking-tight">
          Inovasi &amp; Portofolio Kode Terbuka
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 font-medium">
          Aplikasi dan tools nyata yang dikembangkan oleh tim engineering Bijak Technology
        </p>
      </div>
      <a href="/project" class="text-xs font-bold text-rose-600 hover:underline">
        Lihat Seluruh Portofolio &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      {reposToShow.slice(0, 4).map((project) => (
        <div class="bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
          <div class="space-y-3">
            <span class="text-[10px] font-bold font-mono text-slate-600 dark:text-slate-400 uppercase tracking-widest">
              {project.language || "TypeScript"}
            </span>
            <h4 class="font-bold text-base text-slate-950 dark:text-white leading-snug group-hover:text-rose-600 transition-colors">
              <a href={project.html_url} target="_blank" rel="noopener noreferrer">{project.name}</a>
            </h4>
            <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed line-clamp-3">
              {project.description || "Infrastruktur kode mandiri."}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-[11px] text-slate-600 dark:text-slate-400 font-mono font-medium">
            <span>⭐ {project.stargazers_count}</span>
            <span>🍴 {project.forks_count}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
