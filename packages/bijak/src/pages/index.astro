---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Dapatkan artikel blog dan urutkan berdasarkan tanggal rilis terbaru
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Ambil 1 artikel teratas sebagai Headline
const headlinePost = sortedPosts[0];

// Ambil 3 artikel berikutnya sebagai artikel pendukung headline
const subFeaturedPosts = sortedPosts.slice(1, 4);

// Ambil sisa artikel untuk ditaruh di daftar bawah
const remainingPosts = sortedPosts.slice(4);

// Kategori unik beserta jumlah artikelnya
const categories = [...new Set(posts.map(post => post.data.category))];

// Fetch repositori nyata dari GitHub API
let orgRepos = [];
try {
  const orgReposRes = await fetch(`https://api.github.com/orgs/bijaktechnology/repos?sort=updated&per_page=10`, {
    headers: { 'User-Agent': 'Astro-App-Build' }
  });
  if (orgReposRes.ok) {
    orgRepos = await orgReposRes.json();
  }
} catch (e) {
  // Silent fallback
}

// Fallback data jika API offline atau limit terlampaui
const fallbackRepos = [
  {
    name: "storaji",
    description: "Sistem manajemen inventaris (Inventory Management System) yang ringan, cepat, dan responsif untuk kebutuhan bisnis UMKM.",
    language: "Go",
    stargazers_count: 124,
    forks_count: 18,
    html_url: "https://github.com/bijaktechnology/storaji"
  },
  {
    name: "storaji-ui",
    description: "Antarmuka grafis desktop modern untuk aplikasi manajemen inventaris Storaji yang dikembangkan dengan Electron dan Angular.",
    language: "TypeScript",
    stargazers_count: 86,
    forks_count: 12,
    html_url: "https://github.com/bijaktechnology/storaji-ui"
  },
  {
    name: "speech-synthesis",
    description: "Mesin pengolah teks-ke-suara (Text-to-Speech handler) yang dikustomisasi khusus untuk Lumen Robot Friend.",
    language: "Python",
    stargazers_count: 45,
    forks_count: 8,
    html_url: "https://github.com/bijaktechnology/speech-synthesis"
  },
  {
    name: "WiFiManager",
    description: "Fork khusus pengelola koneksi WiFi mikrokontroler ESP8266 dengan portal penangkapan captive portal web yang dimodifikasi.",
    language: "C++",
    stargazers_count: 32,
    forks_count: 15,
    html_url: "https://github.com/bijaktechnology/WiFiManager"
  }
];

const reposToShow = orgRepos.length > 0 ? orgRepos : fallbackRepos;
const featuredProjects = reposToShow.slice(0, 3);
---

<Layout title="Redaksi Utama - Portal Informasi Teknologi">
  <!-- Grid layout utama koran -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Bagian Utama (Kolom Kiri & Tengah) - Lebar 2 Kolom di Desktop -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Headline Berita Utama -->
      {headlinePost && (
        <article class="border-b border-neutral-300 pb-8">
          <span class="inline-block bg-rose-600 text-white text-xs font-bold uppercase tracking-wider px-2 py-1 mb-3">
            {headlinePost.data.category}
          </span>
          <h2 class="newspaper-title text-3xl md:text-5xl font-extrabold text-neutral-900 tracking-tight leading-tight hover:text-rose-600 transition-colors">
            <a href={`/blog/${headlinePost.id}`}>{headlinePost.data.title}</a>
          </h2>
          <div class="flex items-center gap-3 text-xs font-serif text-neutral-500 my-3">
            <span>Oleh <strong class="text-neutral-800">{headlinePost.data.author}</strong></span>
            <span>&bull;</span>
            <span>{headlinePost.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
          <p class="text-neutral-700 leading-relaxed text-base md:text-lg mb-4">
            {headlinePost.data.description}
          </p>
          <a href={`/blog/${headlinePost.id}`} class="inline-flex items-center text-sm font-bold text-rose-600 hover:text-neutral-900 uppercase tracking-wider">
            Baca Berita Selengkapnya &rarr;
          </a>
        </article>
      )}

      <!-- Sub-Featured Grid (3 Artikel Pendukung) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-b border-neutral-300 pb-8">
        {subFeaturedPosts.map((post) => (
          <article class="space-y-2">
            <span class="text-xs font-bold text-rose-600 uppercase tracking-widest block">
              {post.data.category}
            </span>
            <h3 class="newspaper-title text-xl font-bold text-neutral-900 leading-snug hover:text-rose-600 transition-colors">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="text-xs text-neutral-600 line-clamp-3">
              {post.data.description}
            </p>
            <div class="text-[10px] font-serif text-neutral-400">
              {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </article>
        ))}
      </div>

      <!-- Sisa Artikel Berita Lainnya -->
      <div class="space-y-6">
        <h3 class="newspaper-title text-2xl font-bold uppercase border-b-2 border-neutral-900 pb-2">
          Kabar Terkini Lainnya
        </h3>
        <div class="divide-y divide-neutral-200">
          {remainingPosts.map((post) => (
            <article class="py-4 first:pt-0 flex flex-col sm:flex-row justify-between items-start gap-4">
              <div class="space-y-1">
                <span class="text-xs font-semibold text-neutral-500 uppercase">
                  {post.data.category}
                </span>
                <h4 class="newspaper-title text-lg font-bold text-neutral-900 hover:text-rose-600 transition-colors">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h4>
                <p class="text-sm text-neutral-600">
                  {post.data.description}
                </p>
              </div>
              <div class="text-xs font-serif text-neutral-400 whitespace-nowrap pt-1">
                {post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>

    <!-- Sidebar Kanan (Lebar 1 Kolom) -->
    <div class="space-y-8 lg:border-l lg:border-neutral-300 lg:pl-8">
      
      <!-- Box Slogan Redaksi -->
      <div class="bg-neutral-900 text-neutral-100 p-6 border-4 border-double border-neutral-800">
        <h4 class="newspaper-title text-xl font-bold uppercase tracking-wider mb-2 text-rose-500">
          Visi Redaksi
        </h4>
        <p class="text-xs font-serif italic leading-relaxed text-neutral-300">
          "Menyajikan informasi, analisis, dan solusi praktis teknologi untuk mempercepat digitalisasi ekosistem bisnis dan komunitas Indonesia secara bijak."
        </p>
      </div>

      <!-- Widget Topik/Kategori -->
      <div class="border border-neutral-300 p-5 bg-white">
        <h4 class="newspaper-title text-lg font-bold uppercase border-b-2 border-neutral-900 pb-2 mb-4">
          Kategori Liputan
        </h4>
        <ul class="divide-y divide-neutral-200 text-sm">
          {categories.map((category) => {
            const count = posts.filter(post => post.data.category === category).length;
            return (
              <li class="py-2 flex justify-between items-center">
                <a href={`/blog?category=${category}`} class="font-semibold text-neutral-800 hover:text-rose-600 capitalize">
                  {category}
                </a>
                <span class="bg-neutral-100 text-neutral-600 text-xs px-2 py-0.5 rounded-full border border-neutral-200">
                  {count}
                </span>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Widget Proyek Terbaru (Koran style mini-ads) -->
      <div class="border-2 border-neutral-900 p-5 bg-[#faf9f5]">
        <h4 class="newspaper-title text-lg font-bold uppercase border-b border-neutral-900 pb-2 mb-4 text-center">
          Ikhtisar Portofolio
        </h4>
        <div class="space-y-4">
          {featuredProjects.map((project) => (
            <div class="border-b border-dashed border-neutral-300 pb-3 last:border-0 last:pb-0">
              <span class="text-[10px] uppercase font-bold text-rose-600 tracking-wider">
                {project.language || "Mix"}
              </span>
              <h5 class="font-bold text-sm text-neutral-900 hover:underline">
                <a href={project.html_url} target="_blank" rel="noopener noreferrer">{project.name}</a>
              </h5>
              <p class="text-xs text-neutral-600 line-clamp-2 mt-1">
                {project.description || "Tidak ada deskripsi proyek."}
              </p>
            </div>
          ))}
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-300 text-center">
          <a href="/project" class="text-xs font-bold uppercase text-rose-600 hover:text-neutral-900 tracking-widest">
            Lihat Semua Proyek &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Section Portofolio Khusus Horizontal bawah dengan garis pembatas ganda -->
  <section class="mt-16 pt-8 border-t-4 border-double border-neutral-900">
    <div class="text-center mb-8">
      <h3 class="newspaper-title text-3xl font-extrabold uppercase tracking-tight">
        Kolom Solusi Industri
      </h3>
      <p class="text-sm italic font-serif text-neutral-600">
        Inovasi perangkat lunak dan aplikasi nyata yang dikembangkan oleh tim redaksi
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      {reposToShow.slice(0, 4).map((project) => (
        <div class="bg-white border border-neutral-300 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest">
              {project.language || "Mix"}
            </span>
            <h4 class="font-bold text-base text-neutral-900 leading-snug">
              <a href={project.html_url} target="_blank" rel="noopener noreferrer" class="hover:underline">{project.name}</a>
            </h4>
            <p class="text-xs text-neutral-600 leading-relaxed line-clamp-4">
              {project.description || "Tidak ada deskripsi proyek."}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 flex justify-between items-center text-[10px] text-neutral-400 font-mono">
            <span>⭐ {project.stargazers_count}</span>
            <span>🍴 {project.forks_count}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
