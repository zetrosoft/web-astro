---
import Layout from '../layouts/Layout.astro';

const title = "Proyek & Portofolio Solusi";
const description = "Daftar lengkap solusi sistem informasi, aplikasi IoT, dan repositori open-source resmi dari organisasi Bijak Technology.";

// Menyiapkan repositori dinamis dari GitHub API
let orgRepos = [];
let errorMsg = "";

try {
  const orgReposRes = await fetch(`https://api.github.com/orgs/bijaktechnology/repos?sort=updated&per_page=10`, {
    headers: { 'User-Agent': 'Astro-App-Build' }
  });
  if (orgReposRes.ok) {
    orgRepos = await orgReposRes.json();
  } else {
    errorMsg = "Gagal memuat repositori dari GitHub API. Menggunakan model fallback.";
  }
} catch (e) {
  errorMsg = "Terjadi masalah jaringan saat menghubungi GitHub API.";
}

// Fallback data jika API offline atau limit terlampaui
const fallbackRepos = [
  {
    name: "storaji",
    description: "Sistem manajemen inventaris (Inventory Management System) yang ringan, cepat, dan responsif untuk kebutuhan bisnis UMKM.",
    language: "Go",
    stargazers_count: 124,
    forks_count: 18,
    html_url: "https://github.com/bijaktechnology/storaji"
  },
  {
    name: "storaji-ui",
    description: "Antarmuka grafis desktop modern untuk aplikasi manajemen inventaris Storaji yang dikembangkan dengan Electron dan Angular.",
    language: "TypeScript",
    stargazers_count: 86,
    forks_count: 12,
    html_url: "https://github.com/bijaktechnology/storaji-ui"
  },
  {
    name: "speech-synthesis",
    description: "Mesin pengolah teks-ke-suara (Text-to-Speech handler) yang dikustomisasi khusus untuk Lumen Robot Friend.",
    language: "Python",
    stargazers_count: 45,
    forks_count: 8,
    html_url: "https://github.com/bijaktechnology/speech-synthesis"
  },
  {
    name: "WiFiManager",
    description: "Fork khusus pengelola koneksi WiFi mikrokontroler ESP8266 dengan portal penangkapan captive portal web yang dimodifikasi.",
    language: "C++",
    stargazers_count: 32,
    forks_count: 15,
    html_url: "https://github.com/bijaktechnology/WiFiManager"
  }
];

const reposToShow = orgRepos.length > 0 ? orgRepos : fallbackRepos;
---

<Layout title={title} description={description}>
  <div class="space-y-8">
    
    <!-- Header Kolom Proyek -->
    <div class="border-b border-slate-300/80 dark:border-slate-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-950 dark:text-white tracking-tight mb-2">
        Inovasi &amp; Portofolio Solusi Industri
      </h1>
      <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
        Portofolio rekayasa perangkat lunak, sistem kasir Blonjo POS, dan repositori open-source resmi Bijak Technology.
      </p>
    </div>

    <!-- Peringatan API jika offline -->
    {errorMsg && (
      <div class="p-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700 text-amber-900 dark:text-amber-200 text-xs font-mono rounded-xl">
        ⚠️ {errorMsg} (Menggunakan data arsip statis)
      </div>
    )}

    <!-- Bento Grid Proyek dari GitHub API -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {reposToShow.map(project => (
        <div class="bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow group">
          <div class="space-y-4">
            <div class="flex justify-between items-start gap-4">
              <span class="bg-rose-100/80 text-rose-800 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-300/60 dark:border-rose-900 text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md">
                {project.language || "Mix"}
              </span>
              <span class="text-xs font-mono text-slate-600 dark:text-slate-400 font-medium">
                {project.license ? project.license.name : "Open Source"}
              </span>
            </div>
            <h2 class="text-xl font-bold text-slate-950 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">
              <a href={project.html_url} target="_blank" rel="noopener noreferrer">{project.name}</a>
            </h2>
            <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed min-h-[50px]">
              {project.description || "Infrastruktur kode mandiri yang dikembangkan untuk otomasi sistem."}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-[11px] text-slate-600 dark:text-slate-400 font-mono font-medium">
            <div class="flex gap-4">
              <span class="flex items-center gap-1">⭐ {project.stargazers_count}</span>
              <span class="flex items-center gap-1">🍴 {project.forks_count}</span>
            </div>
            <a href={project.html_url} target="_blank" rel="noopener noreferrer" class="text-xs font-bold uppercase text-rose-600 dark:text-rose-400 hover:underline">
              Source Code &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Layanan Kolaborasi -->
    <div class="mt-12 bg-gradient-to-br from-slate-900 via-slate-850 to-slate-900 text-white p-8 rounded-3xl border border-slate-700 shadow-xl text-center space-y-4">
      <h3 class="text-2xl font-extrabold uppercase tracking-wider text-rose-400">
        Tertarik Mengembangkan Solusi Bersama Kami?
      </h3>
      <p class="max-w-2xl mx-auto text-sm leading-relaxed text-slate-300">
        Dari implementasi ERPNext bareng Samkarsa, integrasi kasir UMKM retail Blonjo, hingga smart contract Avalanche dan asisten WhatsApp AI. Kami siap merekayasa teknologi yang efisien dan terukur.
      </p>
      <div class="pt-2">
        <a href="/contact" class="inline-block bg-rose-600 text-white font-bold text-xs uppercase tracking-widest px-6 py-3 rounded-xl hover:bg-rose-500 transition-colors shadow-md">
          Diskusikan Proyek Anda &rarr;
        </a>
      </div>
    </div>

  </div>
</Layout>
