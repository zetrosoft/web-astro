---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import HostingerBox from '../../components/HostingerBox.astro';
import KusumaMapSpotlight from '../../components/KusumaMapSpotlight.astro';
import SamkarsaIndustryRef from '../../components/SamkarsaIndustryRef.astro';
import SocialReadyBox from '../../components/SocialReadyBox.astro';
import ArticleFaqSchema from '../../components/ArticleFaqSchema.astro';
import MediumCompatibleTable from '../../components/MediumCompatibleTable.astro';
import VisualTcoInfographic from '../../components/VisualTcoInfographic.astro';
import VisualInfographic from '../../components/VisualInfographic.astro';
import { getPostImage } from '../../utils/heroImage';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths = [];
  for (const post of posts) {
    paths.push({
      params: { id: post.id },
      props: { post },
    });
    // Backward-compatibility untuk tautan lama v15
    if (post.id === 'arsitektur-erpnext-v16-distribusi-manufaktur-vps-kvm') {
      paths.push({
        params: { id: 'arsitektur-erpnext-v15-distribusi-manufaktur-vps-kvm' },
        props: { post },
      });
    }
  }
  return paths;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Ambil artikel lain untuk rekomendasi di sidebar berbasis Smart Topical Silo (Prioritaskan kategori & tag yang sama)
const allPosts = await getCollection('blog');
const currentTags = new Set((post.data.tags || []).map((t: string) => t.toLowerCase()));
const recentPosts = allPosts
  .filter(p => p.id !== post.id && p.id !== 'agentic-ai-adaptation-cheap-lightweight-efficient-systems')
  .map(p => {
    let relevance = 0;
    if (p.data.category === post.data.category) relevance += 10;
    for (const t of (p.data.tags || [])) {
      if (currentTags.has(t.toLowerCase())) relevance += 3;
    }
    return { post: p, relevance };
  })
  .sort((a, b) => {
    if (b.relevance !== a.relevance) return b.relevance - a.relevance;
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .slice(0, 4)
  .map(item => item.post);

const nextReadPost = recentPosts[0];

// Aturan Randomisasi Kotak Samkarsa & Kusuma (tidak harus muncul di setiap artikel)
const idHash = post.id.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const isKusumaTopic = post.data.category?.toLowerCase().includes('ritel') || 
                      post.data.category?.toLowerCase().includes('sembako') || 
                      post.data.category?.toLowerCase().includes('umkm') || 
                      post.data.tags?.some(t => ['ritel', 'sembako', 'boyolali', 'kusuma'].includes(t.toLowerCase()));
const showKusumaBox = isKusumaTopic && (post.id.includes('kusuma') || idHash % 3 === 0);

const isSamkarsaTopic = post.data.category?.toLowerCase().includes('erp') || 
                        post.data.category?.toLowerCase().includes('enterprise') || 
                        post.data.category?.toLowerCase().includes('manufaktur') || 
                        post.data.category?.toLowerCase().includes('distribusi');
const showSamkarsaBox = isSamkarsaTopic && (idHash % 2 === 0);

const canonicalUrl = `https://bijaktechnology.com/blog/${post.id}/`;
const imageUrl = post.data.image?.startsWith('http') 
  ? post.data.image 
  : `https://bijaktechnology.com${post.data.image || '/images/og-image.jpg'}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "headline": post.data.title,
  "description": post.data.description,
  "image": [imageUrl],
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://bijaktechnology.com/zetrosoft"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bijak Technology",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bijaktechnology.com/images/logo-bijak-horizontal.png"
    }
  },
  "articleSection": post.data.category,
  "keywords": post.data.tags?.join(", ")
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Utama",
      "item": "https://bijaktechnology.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://bijaktechnology.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.category,
      "item": `https://bijaktechnology.com/blog?category=${encodeURIComponent(post.data.category || '')}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": post.data.title,
      "item": canonicalUrl
    }
  ]
};
---

<Layout 
  title={post.data.title} 
  description={post.data.description}
  image={post.data.image || '/images/og-image.jpg'}
  type="article"
  articleMeta={{
    pubDate: post.data.pubDate,
    author: post.data.author,
    category: post.data.category,
    tags: post.data.tags
  }}
  alternateEn={`https://bijaktechnology.com/en/blog/${post.id}/`}
  alternateId={`https://bijaktechnology.com/blog/${post.id}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

  <!-- Breadcrumb Navigasi -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-400 mb-6 uppercase tracking-wider">
    <a href="/" class="hover:text-rose-600 transition-colors">Utama</a>
    <span>/</span>
    <a href="/blog" class="hover:text-rose-600 transition-colors">Blog</a>
    <span>/</span>
    <span class="text-rose-600 truncate max-w-xs">{post.data.category}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Konten Utama Halaman Artikel -->
    <main class="lg:col-span-8">
      <!-- Article Card Wrapper -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-300/80 dark:border-slate-800 shadow-sm">
        
        <!-- Category & Read Time -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
          <a href={`/blog?category=${post.data.category}`} class="bg-rose-100/80 text-rose-800 dark:bg-rose-950/60 dark:text-rose-400 font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full hover:bg-rose-600 hover:text-white transition-all">
            {post.data.category}
          </a>
          <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            6 min baca
          </span>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-[1.2] mb-6">
          {post.data.title}
        </h1>

        <!-- Short Summary / Lead Paragraph Box -->
        <div class="bg-slate-100/90 dark:bg-slate-800/60 border-l-4 border-rose-500 rounded-r-2xl p-5 mb-8">
          <p class="text-slate-800 dark:text-slate-200 font-medium text-base sm:text-lg leading-relaxed m-0">
            {post.data.description}
          </p>
        </div>

        <!-- Author & Date Metadata -->
        <div class="flex items-center gap-4 py-4 mb-8 border-y border-slate-200 dark:border-slate-800">
          <a href="/zetrosoft/" class="w-11 h-11 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md hover:scale-105 transition-transform" title="Profil Penulis & Penanggung Jawab Redaksi">
            IP
          </a>
          <div>
            <div class="text-sm font-bold text-slate-950 dark:text-white uppercase tracking-wide">
              <a href="/zetrosoft/" class="hover:text-rose-600 transition-colors">
                Iswan Putera
              </a>
            </div>
            <div class="text-xs text-slate-600 dark:text-slate-400 font-medium">
              Oleh <a href="/zetrosoft/" class="font-semibold text-rose-600 dark:text-rose-400 hover:underline">Iswan Putera</a> • {post.data.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })} {post.data.pubDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' })} WIB
            </div>
          </div>
        </div>

        <!-- Hero Image (Free-to-Use with Relevance & High-Res) -->
        <figure class="mb-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm not-prose bg-slate-100 dark:bg-slate-800">
          <img 
            src={getPostImage(post)} 
            alt={post.data.title}
            class="w-full h-auto aspect-video object-cover transition-transform duration-500 hover:scale-[1.01]"
            loading="eager"
            decoding="async"
            width="1200"
            height="675"
          />
        </figure>

        <!-- 1. AdSense Slot 1: Top In-Article Leaderboard -->
        <AdSenseUnit className="mb-8" />

        <!-- Isi Artikel Utama MDX -->
        <article class="prose max-w-none prose-slate dark:prose-invert">
          <Content components={{ AdSenseUnit: InArticleAd, KusumaMapSpotlight, SamkarsaIndustryRef, HostingerBox, ArticleFaqSchema, table: MediumCompatibleTable, VisualTcoInfographic, VisualInfographic }} />
        </article>

        <!-- 2. AdSense Slot 2: Mid-Article / Post-Content Unit (In-Article Ad 6901499930) -->
        <AdSenseUnit variant="in-article" className="my-8" />

        <!-- Smart Contextual Hostinger Partner Box -->
        <HostingerBox category={post.data.category} variant="in-article" />

        {/* Ekosistem Spotlight Khusus Berdasarkan Kategori & Topik (Ditampilkan secara acak/proporsional) */}
        {showKusumaBox && (
          <KusumaMapSpotlight />
        )}
        {showSamkarsaBox && (
          <SamkarsaIndustryRef />
        )}

        <!-- 3. AdSense Slot 3: Bottom In-Article / Pre-Tags Unit -->
        <AdSenseUnit format="auto" className="mt-8 mb-4" />

        <!-- Growth Hacker Viral Loop: Next Recommended Read & Free Interactive Calculator CTA -->
        <div class="my-8 grid grid-cols-1 md:grid-cols-2 gap-4 not-prose">
          {nextReadPost && (
            <a href={`/blog/${nextReadPost.id}/`} class="group overflow-hidden rounded-2xl bg-slate-100/90 dark:bg-slate-800/70 border border-slate-300/80 dark:border-slate-700 hover:border-rose-500 transition-all flex flex-col justify-between">
              <div>
                <div class="aspect-video h-32 w-full overflow-hidden bg-slate-200 dark:bg-slate-800 border-b border-slate-300/60 dark:border-slate-700">
                  <img
                    src={getPostImage(nextReadPost)}
                    alt={nextReadPost.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="338"
                  />
                </div>
                <div class="p-5 pb-0">
                  <span class="text-[10px] font-extrabold uppercase tracking-wider text-rose-600 dark:text-rose-400">
                    📖 Bacaan Lanjutan Direkomendasikan ({nextReadPost.data.category})
                  </span>
                  <h4 class="font-bold text-sm sm:text-base text-slate-950 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors mt-1.5 leading-snug">
                    {nextReadPost.data.title}
                  </h4>
                </div>
              </div>
              <div class="px-5 pb-5">
                <span class="text-xs font-bold text-rose-600 dark:text-rose-400 mt-3 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  Baca Artikel Selanjutnya &rarr;
                </span>
              </div>
            </a>
          )}
        </div>

        <!-- Tags & Topic Exploration -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Topik Terkait:</span>
              {post.data.tags.map(tag => (
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs px-3 py-1 rounded-lg font-semibold border border-slate-300/80 dark:border-slate-700 hover:bg-rose-500 hover:text-white transition-all cursor-default">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Author Profile Card (E-E-A-T Authority) -->
        <div class="my-8 p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 not-prose flex flex-col sm:flex-row items-center sm:items-start gap-5 shadow-sm">
          <a href="/zetrosoft/" class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-rose-600 to-amber-600 flex items-center justify-center text-white font-extrabold text-2xl shadow-md shrink-0">
            IP
          </a>
          <div class="space-y-2 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <h3 class="font-extrabold text-lg text-slate-950 dark:text-white">
                <a href="/zetrosoft/" class="hover:text-rose-600 transition-colors">Iswan Putera</a>
              </h3>
              <span class="text-[10px] font-bold uppercase tracking-wider bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-400 px-2 py-0.5 rounded">
                Principal Software Architect
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-sans">
              Software Architect &amp; Pengembang Sistem Senior dengan pengalaman lebih dari satu dekade dalam rekayasa sistem terdistribusi, private cloud, dan implementasi ERP korporasi. Bertindak sebagai Lead Technology Writer di Bijak Technology.
            </p>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-1 text-xs font-semibold">
              <a href="https://www.linkedin.com/in/iswanputera/" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline">
                LinkedIn Profile &rarr;
              </a>
              <span class="text-slate-300 dark:text-slate-700">•</span>
              <a href="https://samkarsa.com" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 hover:underline">
                Enterprise Portfolio (samkarsa.com) &rarr;
              </a>
              <span class="text-slate-300 dark:text-slate-700">•</span>
              <a href="mailto:iswanputera@gmail.com" class="text-slate-600 dark:text-slate-400 hover:text-rose-600">
                iswanputera@gmail.com
              </a>
            </div>
          </div>
        </div>

        <!-- Social Share & Ready-to-Post Media Box -->
        <SocialReadyBox 
          title={post.data.title}
          url={`https://bijaktechnology.com/blog/${post.id}`}
          social={post.data.social}
          lang="id"
        />

        <script is:inline>
          (function() {
            // Inisialisasi Google AdSense slots
            try {
              const adElements = document.querySelectorAll('.adsbygoogle');
              adElements.forEach(() => {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              });
            } catch (e) {}
          })();
        </script>

      </div>

      <!-- Navigation Bottom Bar -->
      <div class="mt-8 flex justify-between items-center px-2">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Daftar Blog
        </a>
      </div>
    </main>

    <!-- Sidebar Kanan -->
    <aside class="lg:col-span-4 space-y-8">
      
      <!-- Widget Berita Populer -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-300/80 dark:border-slate-800 shadow-sm sticky top-6">
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
          <div class="w-2.5 h-6 bg-rose-600 rounded-full"></div>
          <h3 class="font-extrabold text-lg text-slate-950 dark:text-white">
            Artikel Terkait Lainnya
          </h3>
        </div>
        
        <div class="space-y-6">
          {recentPosts.map((p) => (
            <div class="group border-b border-slate-200 dark:border-slate-800/60 pb-5 last:border-0 last:pb-0 flex gap-3.5 items-start">
              <a href={`/blog/${p.id}/`} class="w-20 h-16 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shrink-0 block mt-0.5">
                <img
                  src={getPostImage(p)}
                  alt={p.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="160"
                  height="128"
                />
              </a>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md inline-block">
                  {p.data.category}
                </span>
                <h4 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-slate-200 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug mt-1.5 line-clamp-2">
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                </h4>
                <div class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-1">
                  {p.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Widget CTA Samkarsa -->
        <div class="mt-8 p-5 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl border border-slate-700 shadow-lg">
          <h4 class="font-extrabold text-base mb-2 text-rose-400">
            Transformasi Digital Enterprise
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Butuh konsultasi arsitektur sistem atau pengembangan Web3 enterprise patuh regulasi?
          </p>
          <a href="https://samkarsa.com" target="_blank" class="inline-flex items-center gap-1.5 w-full justify-center bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition-all shadow-md">
            Kunjungi Samkarsa &rarr;
          </a>
        </div>

        <!-- Widget Hostinger Partner Sidebar -->
        <div class="mt-8">
          <HostingerBox category={post.data.category} variant="sidebar" />
        </div>

        <!-- Sticky Sidebar AdSense Display Unit -->
        <AdSenseUnit format="rectangle" minHeight="min-h-[250px]" className="mt-8" />
      </div>

    </aside>
  </div>
</Layout>
