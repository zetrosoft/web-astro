---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Ambil artikel lain untuk rekomendasi di sidebar
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<Layout title={post.data.title} description={post.data.description}>
  <!-- Breadcrumb Navigasi -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6 uppercase tracking-wider">
    <a href="/" class="hover:text-rose-600 transition-colors">Utama</a>
    <span>/</span>
    <a href="/blog" class="hover:text-rose-600 transition-colors">Blog</a>
    <span>/</span>
    <span class="text-rose-600 truncate max-w-xs">{post.data.category}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Konten Utama Halaman Artikel -->
    <main class="lg:col-span-8">
      <!-- Article Card Wrapper -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        
        <!-- Category & Read Time -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
          <a href={`/blog?category=${post.data.category}`} class="bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-400 font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full hover:bg-rose-600 hover:text-white transition-all">
            {post.data.category}
          </a>
          <span class="text-xs font-medium text-slate-400 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            6 min baca
          </span>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.2] mb-6">
          {post.data.title}
        </h1>

        <!-- Short Summary / Lead Paragraph Box -->
        <div class="bg-slate-50 dark:bg-slate-800/50 border-l-4 border-rose-500 rounded-r-2xl p-5 mb-8">
          <p class="text-slate-600 dark:text-slate-300 font-medium text-base sm:text-lg leading-relaxed m-0">
            {post.data.description}
          </p>
        </div>

        <!-- Author & Date Metadata -->
        <div class="flex items-center gap-4 py-4 mb-8 border-y border-slate-100 dark:border-slate-800">
          <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
            {post.data.author.charAt(0).toUpperCase()}
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wide">
              {post.data.author}
            </div>
            <div class="text-xs text-slate-400">
              {post.data.pubDate.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </div>

        <!-- Isi Artikel Utama MDX -->
        <article class="prose max-w-none prose-slate dark:prose-invert">
          <Content />
        </article>

        <!-- Tags & Topic Exploration -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Topik Terkait:</span>
              {post.data.tags.map(tag => (
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs px-3 py-1 rounded-lg font-semibold hover:bg-rose-500 hover:text-white transition-all cursor-default">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Social Share & Article Interaction Bar -->
        <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Bagikan Wawasan Ini</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Sebarkan artikel ini ke jaringan profesional Anda</div>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <!-- Share LinkedIn -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://bijaktechnology.com/blog/${post.id}`)}`}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
              aria-label="Bagikan ke LinkedIn"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9Z"/></svg>
              LinkedIn
            </a>

            <!-- Share X / Twitter -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`https://bijaktechnology.com/blog/${post.id}`)}&text=${encodeURIComponent(`${post.data.title} via @bijaktech`)}`}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-black text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
              aria-label="Bagikan ke X"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X
            </a>

            <!-- Share WhatsApp -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.data.title}\n\nBaca selengkapnya di: https://bijaktechnology.com/blog/${post.id}`)}`}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
              aria-label="Bagikan ke WhatsApp"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.86-.38-4.11-1.1l-.29-.17-3.11.82.83-3.03-.19-.31a8.16 8.16 0 0 1-1.25-4.47c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/></svg>
              WhatsApp
            </a>

            <!-- Copy Link Button -->
            <button
              id="copy-link-btn"
              type="button"
              data-url={`https://bijaktechnology.com/blog/${post.id}`}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold border border-slate-200 dark:border-slate-700 transition-all cursor-pointer"
              aria-label="Salin Tautan Artikel"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              <span id="copy-btn-text">Salin Tautan</span>
            </button>
          </div>
        </div>

        <script is:inline>
          (function() {
            // Inisialisasi Copy Link
            const copyBtn = document.getElementById('copy-link-btn');
            const copyText = document.getElementById('copy-btn-text');
            if (copyBtn && copyText) {
              copyBtn.addEventListener('click', async function() {
                const url = copyBtn.getAttribute('data-url') || window.location.href;
                try {
                  await navigator.clipboard.writeText(url);
                  copyText.innerText = 'Tersalin!';
                  copyBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300', 'dark:bg-emerald-950/50', 'dark:text-emerald-300');
                  setTimeout(() => {
                    copyText.innerText = 'Salin Tautan';
                    copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300', 'dark:bg-emerald-950/50', 'dark:text-emerald-300');
                  }, 2500);
                } catch (e) {}
              });
            }

            // Inisialisasi Google AdSense slots
            try {
              const adElements = document.querySelectorAll('.adsbygoogle');
              adElements.forEach(() => {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              });
            } catch (e) {}
          })();
        </script>

      </div>

      <!-- Navigation Bottom Bar -->
      <div class="mt-8 flex justify-between items-center px-2">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Daftar Blog
        </a>
      </div>
    </main>

    <!-- Sidebar Kanan -->
    <aside class="lg:col-span-4 space-y-8">
      
      <!-- Widget Berita Populer -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm sticky top-6">
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-slate-100 dark:border-slate-800">
          <div class="w-2.5 h-6 bg-rose-600 rounded-full"></div>
          <h3 class="font-extrabold text-lg text-slate-900 dark:text-white">
            Artikel Terkait Lainnya
          </h3>
        </div>
        
        <div class="space-y-6">
          {recentPosts.map((p) => (
            <div class="group border-b border-slate-100 dark:border-slate-800/60 pb-5 last:border-0 last:pb-0">
              <span class="text-[10px] font-bold uppercase tracking-wider text-rose-600 bg-rose-50 dark:bg-rose-950/40 px-2 py-0.5 rounded-md">
                {p.data.category}
              </span>
              <h4 class="font-bold text-sm text-slate-800 dark:text-slate-200 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug mt-2">
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </h4>
              <div class="text-xs text-slate-400 mt-1">
                {p.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
            </div>
          ))}
        </div>

        <!-- Widget CTA Samkarsa -->
        <div class="mt-8 p-5 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl border border-slate-700 shadow-lg">
          <h4 class="font-extrabold text-base mb-2 text-rose-400">
            Transformasi Digital Enterprise
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Butuh konsultasi arsitektur sistem atau pengembangan Web3 enterprise patuh regulasi?
          </p>
          <a href="https://samkarsa.com" target="_blank" class="inline-flex items-center gap-1.5 w-full justify-center bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition-all shadow-md">
            Kunjungi Samkarsa &rarr;
          </a>
        </div>
      </div>

    </aside>
  </div>
</Layout>
