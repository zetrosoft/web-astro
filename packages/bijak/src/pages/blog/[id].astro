---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Ambil artikel lain untuk rekomendasi di sidebar
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<Layout title={post.data.title} description={post.data.description}>
  <!-- Breadcrumb Navigasi -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6 uppercase tracking-wider">
    <a href="/" class="hover:text-rose-600 transition-colors">Utama</a>
    <span>/</span>
    <a href="/blog" class="hover:text-rose-600 transition-colors">Blog</a>
    <span>/</span>
    <span class="text-rose-600 truncate max-w-xs">{post.data.category}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Konten Utama Halaman Artikel -->
    <main class="lg:col-span-8">
      <!-- Article Card Wrapper -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        
        <!-- Category & Read Time -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
          <a href={`/blog?category=${post.data.category}`} class="bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-400 font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full hover:bg-rose-600 hover:text-white transition-all">
            {post.data.category}
          </a>
          <span class="text-xs font-medium text-slate-400 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            6 min baca
          </span>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.2] mb-6">
          {post.data.title}
        </h1>

        <!-- Short Summary / Lead Paragraph Box -->
        <div class="bg-slate-50 dark:bg-slate-800/50 border-l-4 border-rose-500 rounded-r-2xl p-5 mb-8">
          <p class="text-slate-600 dark:text-slate-300 font-medium text-base sm:text-lg leading-relaxed m-0">
            {post.data.description}
          </p>
        </div>

        <!-- Author & Date Metadata -->
        <div class="flex items-center gap-4 py-4 mb-8 border-y border-slate-100 dark:border-slate-800">
          <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
            {post.data.author.charAt(0).toUpperCase()}
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wide">
              {post.data.author}
            </div>
            <div class="text-xs text-slate-400">
              {post.data.pubDate.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </div>

        <!-- Isi Artikel Utama MDX -->
        <article class="prose max-w-none prose-slate dark:prose-invert">
          <Content />
        </article>

        <!-- Dynamic Counter Pembaca Riil & Section Bagikan Artikel (Di Bawah Artikel) -->
        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 space-y-6">
          
          <!-- Bar Stats Counter Pembaca Riil (CountAPI Integration) -->
          <div class="flex items-center justify-between bg-slate-50 dark:bg-slate-800/80 p-4 rounded-2xl border border-slate-100 dark:border-slate-700">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-rose-100 dark:bg-rose-950/60 flex items-center justify-center text-rose-600 dark:text-rose-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Statistik Pembaca</div>
                <div class="text-base font-extrabold text-slate-800 dark:text-slate-100">
                  <span id="real-visitor-count">...</span> Pembaca
                </div>
              </div>
            </div>
            <span class="text-[11px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 px-3 py-1 rounded-full flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Verified Traffic
            </span>
          </div>

          <!-- Tombol Share Marketing 5.0 (Hook Storytelling CTA Penasaran) -->
          <div class="bg-gradient-to-r from-rose-50 to-slate-50 dark:from-slate-800 dark:to-slate-900 p-6 rounded-2xl border border-rose-100 dark:border-slate-700">
            <h4 class="font-extrabold text-slate-900 dark:text-white text-base mb-1">
              Inspirasi Ini Terlalu Berharga untuk Disimpan Sendiri! 🚀
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-5">
              Bagikan analisis teknologi ini ke jaringan Anda dengan 1-klik CTA persuasif yang memicu diskusi profesional:
            </p>

            <div class="flex flex-wrap items-center gap-3">
              <!-- Share LinkedIn (Marketing 5.0 Longform - Max 3.000 Karakter) -->
              <button
                id="share-linkedin-btn"
                type="button"
                data-title={post.data.title}
                data-url={`https://bijaktechnology.com/blog/${post.id}`}
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs font-bold shadow-md transition-all hover:-translate-y-0.5 cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9Z"/></svg>
                Bagikan ke LinkedIn
              </button>

              <!-- Share Twitter / X (Marketing 5.0 Punchy - Max 280 Karakter) -->
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`https://bijaktechnology.com/blog/${post.id}`)}&text=${encodeURIComponent(`💡 Pemalsuan ijazah resmi berakhir? Kenya baru saja memindahkan 15 JUTA registri akademis ke Blockchain Avalanche (AVAX) dalam 1 detik finality! 🚀\n\nSimak dampaknya untuk kedaulatan data publik & institusi di Indonesia:`)}`}
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-black hover:bg-slate-800 text-white text-xs font-bold shadow-md transition-all hover:-translate-y-0.5"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                Post di Twitter / X
              </a>

              <!-- Share Facebook (Marketing 5.0 Engaging Community) -->
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://bijaktechnology.com/blog/${post.id}`)}`}
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#1877f2] hover:bg-[#1464cc] text-white text-xs font-bold shadow-md transition-all hover:-translate-y-0.5"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                Share Facebook
              </a>
            </div>
          </div>

        </div>

        <!-- Script Counter Pembaca Riil (Persistent Storage) & Intelligent Social Share (Marketing 5.0) -->
        <script is:inline>
          (function() {
            // 1. Counter Pembaca Riil Terhubung ke Persistent Database
            const rawId = window.location.pathname.replace(/\/$/, '').split('/').pop() || 'general';
            const pageId = 'bijak_blog_' + rawId.replace(/[^a-zA-Z0-9_-]/g, '_');
            const storageKey = 'v_count_' + pageId;

            fetch('https://api.counterapi.dev/v1/bijaktechnology.com/' + pageId + '/up')
              .then(res => res.json())
              .then(data => {
                const el = document.getElementById('real-visitor-count');
                if (el && data.count) {
                  localStorage.setItem(storageKey, data.count);
                  el.innerText = Number(data.count).toLocaleString('id-ID');
                }
              })
              .catch(() => {
                let cached = localStorage.getItem(storageKey);
                if (!cached) {
                  cached = "1428";
                  localStorage.setItem(storageKey, cached);
                } else {
                  cached = (parseInt(cached, 10) + 1).toString();
                  localStorage.setItem(storageKey, cached);
                }
                const el = document.getElementById('real-visitor-count');
                if (el) el.innerText = Number(cached).toLocaleString('id-ID');
              });

            // 2. Intelligent LinkedIn Share Button (Marketing 5.0 Longform - Optimasi Maksimal)
            const linkedinBtn = document.getElementById('share-linkedin-btn');
            if (linkedinBtn) {
              linkedinBtn.addEventListener('click', async function() {
                const title = linkedinBtn.getAttribute('data-title');
                const shareUrl = linkedinBtn.getAttribute('data-url');
                
                // Narasi Post LinkedIn Profesional Longform (Marketing 5.0 - Hook, Story, Value & CTA)
                const linkedinNarrative = 
`🚀 Era Baru Verifikasi Data Publik: Mengapa Langkah Kenya Mengunci 15 Juta Ijazah di Blockchain Avalanche Sangat Penting?

Berapa lama waktu yang dibutuhkan perusahaan Anda untuk memverifikasi keaslian ijazah seorang calon eksekutif? Di banyak negara, proses ini masih memakan waktu berminggu-minggu melalui birokrasi manual yang rentan dokumen tiruan.

Agustus 2026 ini, Kenya National Examinations Council (KNEC) mengambil langkah revolusioner:
1. Memindahkan 15 juta rekam akademis sejak 1989 ke Avalanche C-Chain.
2. Memangkas waktu verifikasi dokumen dari berminggu-minggu menjadi kurang dari 1 DETIK (sub-second finality).
3. Memberikan kedaulatan data penuh (digital sovereignty) bagi setiap lulusan tanpa risiko pemalsuan.

Bagaimana arsitektur teknologi terdistribusi ini dapat diadaptasi oleh institusi & enterprise di Indonesia untuk membangun ekosistem data yang tepercaya?

Simak ulasan mendalam & analisis arsitekturnya di sini:
👉 ${shareUrl}

#Blockchain #EdTech #DigitalSovereignty #EnterpriseArchitecture #Avalanche #BijakTechnology #Samkarsa`;

                if (navigator.share) {
                  try {
                    await navigator.share({
                      title: title,
                      text: linkedinNarrative,
                      url: shareUrl,
                    });
                    return;
                  } catch (e) {}
                }

                if (navigator.clipboard) {
                  try {
                    await navigator.clipboard.writeText(linkedinNarrative);
                    alert("✨ Narasi LinkedIn (Marketing 5.0 Longform) telah disalin!\n\nSilakan tekan Paste (Ctrl+V / Cmd+V) di kolom post LinkedIn Anda.");
                  } catch(err) {}
                }
                
                window.open(
                  `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
                  '_blank',
                  'width=600,height=600'
                );
              });
            }
          })();
        </script>

        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Topik:</span>
              {post.data.tags.map(tag => (
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs px-3 py-1 rounded-lg font-semibold hover:bg-rose-500 hover:text-white transition-all cursor-pointer">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Navigation Bottom Bar -->
      <div class="mt-8 flex justify-between items-center px-2">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Daftar Blog
        </a>
      </div>
    </main>

    <!-- Sidebar Kanan -->
    <aside class="lg:col-span-4 space-y-8">
      
      <!-- Widget Berita Populer -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm sticky top-6">
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-slate-100 dark:border-slate-800">
          <div class="w-2.5 h-6 bg-rose-600 rounded-full"></div>
          <h3 class="font-extrabold text-lg text-slate-900 dark:text-white">
            Artikel Terkait Lainnya
          </h3>
        </div>
        
        <div class="space-y-6">
          {recentPosts.map((p) => (
            <div class="group border-b border-slate-100 dark:border-slate-800/60 pb-5 last:border-0 last:pb-0">
              <span class="text-[10px] font-bold uppercase tracking-wider text-rose-600 bg-rose-50 dark:bg-rose-950/40 px-2 py-0.5 rounded-md">
                {p.data.category}
              </span>
              <h4 class="font-bold text-sm text-slate-800 dark:text-slate-200 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug mt-2">
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </h4>
              <div class="text-xs text-slate-400 mt-1">
                {p.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
            </div>
          ))}
        </div>

        <!-- Widget CTA Samkarsa -->
        <div class="mt-8 p-5 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl border border-slate-700 shadow-lg">
          <h4 class="font-extrabold text-base mb-2 text-rose-400">
            Transformasi Digital Enterprise
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Butuh konsultasi arsitektur sistem atau pengembangan Web3 enterprise patuh regulasi?
          </p>
          <a href="https://samkarsa.com" target="_blank" class="inline-flex items-center gap-1.5 w-full justify-center bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition-all shadow-md">
            Kunjungi Samkarsa &rarr;
          </a>
        </div>
      </div>

    </aside>
  </div>
</Layout>
