---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import HostingerBox from '../../components/HostingerBox.astro';

const posts = await getCollection('blog');
const filteredPosts = posts.filter(post => post.id !== 'agentic-ai-adaptation-cheap-lightweight-efficient-systems');
const sortedPosts = filteredPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Dapatkan kategori unik untuk penyaringan
const categories = [...new Set(filteredPosts.map(post => post.data.category))];
---

<Layout title="Arsip Berita & Artikel" description="Daftar lengkap artikel riset, laporan arsitektur cloud, dan panduan teknologi dari redaksi Bijak Technology.">
  <div class="space-y-8">
    
    <!-- Bagian Pengantar Redaksi -->
    <div class="border-b border-slate-300/80 dark:border-slate-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-950 dark:text-white tracking-tight mb-2">
        Arsip Liputan &amp; Riset Teknologi
      </h1>
      <p class="text-sm text-slate-700 dark:text-slate-300 font-medium">
        Kumpulan investigasi teknis, digitalisasi UMKM ritel, arsitektur ERP enterprise, dan analisis cloud computing.
      </p>
    </div>

    <!-- Kategori Filter Bar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-300/80 dark:border-slate-800 pb-6 text-xs font-semibold">
      <span class="text-slate-700 dark:text-slate-300 mr-2 font-bold uppercase tracking-wider">Topik Liputan:</span>
      <button 
        class="category-btn active px-3.5 py-1.5 rounded-full text-xs font-bold bg-rose-600 text-white shadow-xs transition-all cursor-pointer"
        data-category-btn="all"
      >
        Semua Kategori
      </button>
      {categories.map(category => (
        <button 
          class="category-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-700 text-slate-800 dark:text-slate-200 hover:border-rose-500 hover:text-rose-600 dark:hover:text-rose-400 transition-all cursor-pointer shadow-2xs"
          data-category-btn={category}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Grid List Artikel -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
      {sortedPosts.map(post => (
        <article 
          class="bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow group"
          data-category={post.data.category}
        >
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md inline-block">
              {post.data.category}
            </span>
            <h2 class="text-base sm:text-lg font-bold text-slate-950 dark:text-white leading-snug group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="text-xs text-slate-700 dark:text-slate-300 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-[11px] text-slate-600 dark:text-slate-400 font-mono font-medium">
            <span>Oleh: <strong class="text-slate-800 dark:text-slate-200">{post.data.author}</strong></span>
            <span>{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' })} {post.data.pubDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' })} WIB</span>
          </div>
        </article>
      ))}
    </div>

    <!-- In-Feed AdSense Banner -->
    <AdSenseUnit className="my-10" />

    <!-- Hostinger Partner Banner -->
    <HostingerBox variant="in-article" />

  </div>

  <!-- Client-side filtering script -->
  <script>
    function setupFilter() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category-btn]');
      const articles = document.querySelectorAll<HTMLElement>('#posts-grid article');

      buttons.forEach(button => {
        button.addEventListener('click', () => {
          const selectedCategory = button.getAttribute('data-category-btn');
          
          // Reset style semua tombol
          buttons.forEach(btn => {
            btn.classList.remove('bg-rose-600', 'text-white', 'border-transparent', 'font-bold');
            btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-800', 'dark:text-slate-200', 'border-slate-300/80', 'dark:border-slate-700');
          });

          // Tandai tombol aktif
          button.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-800', 'dark:text-slate-200', 'border-slate-300/80', 'dark:border-slate-700');
          button.classList.add('bg-rose-600', 'text-white', 'border-transparent', 'font-bold');

          // Filter artikel
          articles.forEach(article => {
            const articleCategory = article.getAttribute('data-category');
            if (selectedCategory === 'all' || articleCategory === selectedCategory) {
              article.style.display = 'flex';
            } else {
              article.style.display = 'none';
            }
          });
        });
      });

      // Deteksi URL param ?category=... saat halaman dimuat
      const urlParams = new URLSearchParams(window.location.search);
      const queryCat = urlParams.get('category');
      if (queryCat) {
        const matchedBtn = Array.from(buttons).find(btn => {
          const btnCat = btn.getAttribute('data-category-btn') || '';
          return btnCat.toLowerCase() === queryCat.toLowerCase() || 
                 btnCat.toLowerCase().includes(queryCat.toLowerCase()) ||
                 queryCat.toLowerCase().includes(btnCat.toLowerCase());
        });
        if (matchedBtn) {
          matchedBtn.click();
        }
      }
    }

    setupFilter();
    document.addEventListener('astro:after-swap', setupFilter);
  </script>
</Layout>
