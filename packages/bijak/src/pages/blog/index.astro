---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Dapatkan kategori unik untuk penyaringan
const categories = [...new Set(posts.map(post => post.data.category))];
---

<Layout title="Arsip Berita & Artikel" description="Daftar lengkap artikel, berita, dan panduan teknologi dari redaksi Bijak Technology.">
  <div class="space-y-8">
    
    <!-- Bagian Pengantar Redaksi -->
    <div class="text-center py-6 border-b border-neutral-300">
      <h1 class="newspaper-title text-4xl font-extrabold uppercase tracking-tight">
        Arsip Berita Redaksi
      </h1>
      <p class="text-sm italic font-serif text-neutral-600 mt-2">
        Kumpulan dokumentasi, artikel riset, dan liputan teknologi terlengkap
      </p>
    </div>

    <!-- Kategori Filter Bar -->
    <div class="flex flex-wrap items-center justify-center gap-2 border-b border-neutral-300 pb-6 text-sm font-semibold uppercase tracking-wider">
      <span class="text-neutral-500 mr-2">Topik Liputan:</span>
      <a href="/blog" class="px-3 py-1 bg-neutral-900 text-white hover:bg-rose-600 transition-colors">
        Semua Kategori
      </a>
      {categories.map(category => (
        <button 
          class="px-3 py-1 bg-white border border-neutral-300 text-neutral-800 hover:bg-rose-600 hover:text-white transition-colors"
          data-category-btn={category}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Grid List Artikel -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="posts-grid">
      {sortedPosts.map(post => (
        <article 
          class="bg-white border border-neutral-300 p-6 flex flex-col justify-between hover:shadow-md transition-shadow duration-300"
          data-category={post.data.category}
        >
          <div class="space-y-3">
            <span class="text-xs font-bold text-rose-600 uppercase tracking-widest block">
              {post.data.category}
            </span>
            <h2 class="newspaper-title text-xl font-bold text-neutral-900 leading-snug hover:text-rose-600 transition-colors">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="text-sm text-neutral-600 line-clamp-3">
              {post.data.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-neutral-100 flex justify-between items-center text-xs text-neutral-400">
            <span class="font-serif">Oleh: {post.data.author}</span>
            <span class="font-mono">{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </div>
        </article>
      ))}
    </div>

  </div>

  <!-- Client-side filtering script simple -->
  <script>
    const buttons = document.querySelectorAll('[data-category-btn]');
    const articles = document.querySelectorAll('#posts-grid article');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category-btn');
        
        // Update button active state styles
        buttons.forEach(btn => {
          btn.classList.remove('bg-neutral-900', 'text-white');
          btn.classList.add('bg-white', 'text-neutral-800');
        });
        button.classList.remove('bg-white', 'text-neutral-800');
        button.classList.add('bg-neutral-900', 'text-white');

        // Filter articles
        articles.forEach(article => {
          const articleCategory = article.getAttribute('data-category');
          if (articleCategory === category) {
            (article as HTMLElement).style.display = 'flex';
          } else {
            (article as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
