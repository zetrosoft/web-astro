---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import HostingerBox from '../../components/HostingerBox.astro';
import { getPostImage } from '../../utils/heroImage';

const postsEn = await getCollection('blog_en');
const postsId = await getCollection('blog');
const enMap = new Map(postsEn.map(p => [p.id, p]));
const allIds = new Set([...postsEn.map(p => p.id), ...postsId.map(p => p.id)]);

const posts = Array.from(allIds)
  .filter(id => id !== 'agentic-ai-adaptation-cheap-lightweight-efficient-systems')
  .map(id => enMap.get(id) || postsId.find(p => p.id === id))
  .filter(Boolean) as typeof postsEn;

const sortedPosts = posts.sort((a, b) => {
  const diff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (diff !== 0) return diff;
  return b.id.localeCompare(a.id);
});
const headlinePost = sortedPosts[0];
const subFeaturedPosts = sortedPosts.slice(1, 4);
const remainingPosts = sortedPosts.slice(4);
const categories = [...new Set(posts.map(post => post.data.category))];
---

<Layout title="Independent Technology & Business Journal" description="Enterprise ERP, AI Engineering, Cloud Infrastructure, and Real World Assets" lang="en">
  <!-- Top Headline Section -->
  <section class="mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 group">
        <div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 text-white shadow-xl">
          <a href={`/en/blog/${headlinePost.id}/`} class="relative block aspect-video max-h-[380px] w-full overflow-hidden bg-slate-800 border-b border-slate-800">
            <img
              src={getPostImage(headlinePost)}
              alt={headlinePost.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
              decoding="async"
              width="1200"
              height="675"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/10 to-transparent pointer-events-none"></div>
          </a>
          <div class="relative z-10 p-6 sm:p-10 space-y-4">
            <div class="flex items-center gap-3">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-rose-500 text-white">
                {headlinePost.data.category}
              </span>
              <span class="text-xs font-mono text-slate-400">
                Editorial Lead Story
              </span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight group-hover:text-rose-400 transition-colors">
              <a href={`/en/blog/${headlinePost.id}/`}>{headlinePost.data.title}</a>
            </h2>
            <p class="text-slate-300 text-sm sm:text-base line-clamp-3 leading-relaxed">
              {headlinePost.data.description}
            </p>
            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-800">
              <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
                <span>By <strong class="text-white">{headlinePost.data.author}</strong></span>
                <span>•</span>
                <span>{headlinePost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' })} {headlinePost.data.pubDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' })} WIB</span>
              </div>
              <a
                href={`/en/blog/${headlinePost.id}/`}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all hover:scale-105 cursor-pointer"
                aria-label={`Read full story: ${headlinePost.data.title}`}
              >
                Read Full Story &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right 4 Columns: Sub-featured stories -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Trending Stories
          </span>
          <a href="/en/blog/" class="text-xs font-bold text-rose-600 hover:underline">View All &rarr;</a>
        </div>

        {subFeaturedPosts.map(post => (
          <div class="overflow-hidden rounded-2xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm hover:border-rose-400 transition-all group">
            <a href={`/en/blog/${post.id}/`} class="block aspect-video h-32 w-full overflow-hidden bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-800">
              <img
                src={getPostImage(post)}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                width="600"
                height="338"
              />
            </a>
            <div class="p-4">
              <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2.5 py-1 rounded-md inline-block">
                {post.data.category}
              </span>
              <h3 class="font-bold text-sm sm:text-base text-slate-950 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors mt-2 mb-1.5 leading-snug">
                <a href={`/en/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-slate-700 dark:text-slate-300 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Homepage Native AdSense Banner -->
  <AdSenseUnit className="my-10" />

  <!-- Remaining Stories Grid -->
  <section class="space-y-6">
    <div class="flex items-center justify-between pb-3 border-b border-slate-300/80 dark:border-slate-800">
      <h3 class="text-xl font-extrabold text-slate-950 dark:text-white uppercase tracking-tight">
        Latest In-Depth Tech &amp; Business Reports
      </h3>
      <a href="/en/blog/" class="text-xs font-bold text-rose-600 hover:underline">View All Stories &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {remainingPosts.map(post => (
        <article class="overflow-hidden rounded-2xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:shadow-md hover:border-rose-400/60 transition-all group">
          <div>
            <a href={`/en/blog/${post.id}/`} class="block aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-800">
              <img
                src={getPostImage(post)}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                width="600"
                height="338"
              />
            </a>
            <div class="p-6 pb-0 space-y-2.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md inline-block">
                {post.data.category}
              </span>
              <h4 class="font-bold text-base text-slate-950 dark:text-white leading-snug group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">
                <a href={`/en/blog/${post.id}/`}>{post.data.title}</a>
              </h4>
              <p class="text-xs text-slate-700 dark:text-slate-300 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
          </div>
          <div class="px-6 pb-6">
            <div class="text-[11px] text-slate-600 dark:text-slate-400 pt-4 mt-4 border-t border-slate-200 dark:border-slate-800 font-mono font-medium flex justify-between items-center">
              <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' })} {post.data.pubDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' })} WIB</span>
              <span class="text-rose-600 font-bold group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Bottom Hostinger Showcase -->
  <div class="mt-12">
    <HostingerBox variant="in-article" lang="en" />
  </div>
</Layout>
