---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import InArticleAd from '../../../components/InArticleAd.astro';
import HostingerBox from '../../../components/HostingerBox.astro';
import InArticleAiAdvisor from '../../../components/InArticleAiAdvisor.astro';
import FrappeCloudBox from '../../../components/FrappeCloudBox.astro';
import SocialReadyBox from '../../../components/SocialReadyBox.astro';
import ArticleFaqSchema from '../../../components/ArticleFaqSchema.astro';
import MediumCompatibleTable from '../../../components/MediumCompatibleTable.astro';
import VisualTcoInfographic from '../../../components/VisualTcoInfographic.astro';
import VisualInfographic from '../../../components/VisualInfographic.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import RelatedSiloPosts from '../../../components/RelatedSiloPosts.astro';
import { getPostImage } from '../../../utils/heroImage';

export async function getStaticPaths() {
  const postsEn = await getCollection('blog_en');
  const postsId = await getCollection('blog');

  const enMap = new Map(postsEn.map(p => [p.id, p]));
  const allIds = new Set([...postsEn.map(p => p.id), ...postsId.map(p => p.id)]);

  const paths = [];
  for (const id of allIds) {
    const post = enMap.get(id) || postsId.find(p => p.id === id);
    if (!post) continue;

    paths.push({
      params: { id },
      props: { post },
    });

    // Backward compatibility untuk v15 (seperti URL yang diakses user: /en/blog/arsitektur-erpnext-v15-distribusi-manufaktur-vps-kvm/)
    if (id === 'arsitektur-erpnext-v16-distribusi-manufaktur-vps-kvm') {
      paths.push({
        params: { id: 'arsitektur-erpnext-v15-distribusi-manufaktur-vps-kvm' },
        props: { post },
      });
    }
  }

  return paths;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Ambil artikel lain untuk rekomendasi di sidebar dalam mode EN
const postsEn = await getCollection('blog_en');
const postsId = await getCollection('blog');
const enMap = new Map(postsEn.map(p => [p.id, p]));
const allIds = new Set([...postsEn.map(p => p.id), ...postsId.map(p => p.id)]);
const allPosts = Array.from(allIds)
  .filter(id => id !== post.id && id !== 'agentic-ai-adaptation-cheap-lightweight-efficient-systems')
  .map(id => enMap.get(id) || postsId.find(p => p.id === id))
  .filter(Boolean) as typeof postsEn;

const currentTags = new Set((post.data.tags || []).map((t: string) => t.toLowerCase()));
const recentPosts = allPosts
  .map(p => {
    let relevance = 0;
    if (p.data.category === post.data.category) relevance += 10;
    for (const t of (p.data.tags || [])) {
      if (currentTags.has(t.toLowerCase())) relevance += 3;
    }
    return { post: p, relevance };
  })
  .sort((a, b) => {
    if (b.relevance !== a.relevance) return b.relevance - a.relevance;
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .map(item => item.post);

const relatedSiloPosts = recentPosts.slice(0, 3);

// Detection for ERP / Frappe / Software Architecture Topics
const isErpOrSaTopic = 
  post.data.category?.toLowerCase().includes('erp') ||
  post.data.category?.toLowerCase().includes('frappe') ||
  post.data.category?.toLowerCase().includes('arsitektur') ||
  post.data.category?.toLowerCase().includes('architecture') ||
  post.id.includes('erpnext') ||
  post.id.includes('frappe') ||
  post.id.includes('modular-monolith') ||
  post.id.includes('arsitektur') ||
  post.data.tags?.some((t: string) => 
    ['erp', 'erpnext', 'frappe', 'software architecture', 'arsitektur', 'enterprise'].includes(t.toLowerCase())
  );
const nextReadPost = recentPosts[0];

const canonicalUrl = `https://bijaktechnology.com/en/blog/${post.id}/`;
const imageUrl = post.data.image?.startsWith('http') 
  ? post.data.image 
  : `https://bijaktechnology.com${post.data.image || '/images/og-image.jpg'}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "inLanguage": "en",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "headline": post.data.title,
  "description": post.data.description,
  "image": [imageUrl],
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://bijaktechnology.com/zetrosoft"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bijak Technology",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bijaktechnology.com/images/logo-bijak-horizontal.png"
    }
  },
  "articleSection": post.data.category,
  "keywords": post.data.tags?.join(", ")
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bijaktechnology.com/en/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://bijaktechnology.com/en/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.category,
      "item": `https://bijaktechnology.com/en/blog?category=${encodeURIComponent(post.data.category || '')}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": post.data.title,
      "item": canonicalUrl
    }
  ]
};
---

<Layout 
  title={post.data.title} 
  description={post.data.description} 
  lang="en"
  image={post.data.image || '/images/og-image.jpg'}
  type="article"
  articleMeta={{
    pubDate: post.data.pubDate,
    author: post.data.author,
    category: post.data.category,
    tags: post.data.tags
  }}
  alternateEn={`https://bijaktechnology.com/en/blog/${post.id}/`}
  alternateId={`https://bijaktechnology.com/blog/${post.id}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

  <!-- Top Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-400 mb-6 uppercase tracking-wider">
    <a href="/en" class="hover:text-rose-600 transition-colors">Home</a>
    <span>/</span>
    <a href="/en/blog" class="hover:text-rose-600 transition-colors">Blog</a>
    <span>/</span>
    <span class="text-rose-600 truncate max-w-xs">{post.data.category}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Main Article Column -->
    <main class="lg:col-span-8">
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-300/80 dark:border-slate-800 shadow-sm">
        
        <!-- Category & Read Time -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
          <a href={`/en/blog?category=${post.data.category}`} class="bg-rose-100/80 text-rose-800 dark:bg-rose-950/60 dark:text-rose-400 font-bold text-xs uppercase tracking-widest px-3.5 py-1.5 rounded-full hover:bg-rose-600 hover:text-white transition-all">
            {post.data.category}
          </a>
          <span class="text-xs font-semibold text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            6 min read
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-[1.2] mb-6">
          {post.data.title}
        </h1>

        <!-- Short Summary Box -->
        <div class="bg-slate-100/90 dark:bg-slate-800/60 border-l-4 border-rose-500 rounded-r-2xl p-5 mb-8">
          <p class="text-slate-800 dark:text-slate-200 font-medium text-base sm:text-lg leading-relaxed m-0">
            {post.data.description}
          </p>
        </div>

        <!-- Author & Date Metadata -->
        <div class="flex items-center gap-4 py-4 mb-8 border-y border-slate-200 dark:border-slate-800">
          <a href="/zetrosoft/" class="w-11 h-11 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md hover:scale-105 transition-transform" title="Author Profile & Editorial Desk">
            IP
          </a>
          <div>
            <div class="text-sm font-bold text-slate-950 dark:text-white uppercase tracking-wide">
              <a href="/zetrosoft/" class="hover:text-rose-600 transition-colors">
                Iswan Putera
              </a>
            </div>
            <div class="text-xs text-slate-600 dark:text-slate-400 font-medium">
              By <a href="/zetrosoft/" class="font-semibold text-rose-600 dark:text-rose-400 hover:underline">Iswan Putera</a> • {post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })} {post.data.pubDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Jakarta' })} WIB
            </div>
          </div>
        </div>

        <!-- Hero Image (Free-to-Use with Relevance & High-Res) -->
        <figure class="mb-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm not-prose bg-slate-100 dark:bg-slate-800">
          <img 
            src={getPostImage(post)} 
            alt={post.data.title}
            class="w-full h-auto aspect-video object-cover transition-transform duration-500 hover:scale-[1.01]"
            loading="eager"
            decoding="async"
            width="1200"
            height="675"
          />
        </figure>

        <!-- 1. AdSense Slot 1: Top In-Article Leaderboard -->
        <AdSenseUnit className="mb-8" />

        <!-- Interactive Table of Contents (TOC) -->
        <TableOfContents headings={headings} lang="en" />

        <!-- Article Body with localized components -->
        <article class="prose max-w-none prose-slate dark:prose-invert">
          <Content components={{
            AdSenseUnit: InArticleAd,
            InArticleAiAdvisor,
            HostingerBox,
            FrappeCloudBox,
            ArticleFaqSchema,
            table: MediumCompatibleTable,
            VisualTcoInfographic,
            VisualInfographic
          }} />
        </article>

        <!-- 2. AdSense Slot 2: Mid-Article / Post-Content Unit (In-Article Ad 6901499930) -->
        <AdSenseUnit variant="in-article" className="my-8" />

        <!-- Dynamic Contextual In-Article AI Advisor (English) (Temporarily Hidden) -->
        {/* <InArticleAiAdvisor copilot_config={post.data.copilot_config} category={post.data.category} lang="en" /> */}

        <!-- Smart Contextual Hostinger Partner Box (English) -->
        <HostingerBox category={post.data.category} variant="in-article" lang="en" />

        <!-- Official Frappe Cloud Partner Card (ERP & Software Architecture Topics) -->
        {isErpOrSaTopic && (
          <FrappeCloudBox lang="en" />
        )}

        <!-- 3. AdSense Slot 3: Bottom In-Article / Pre-Tags Unit -->
        <AdSenseUnit format="auto" className="mt-8 mb-4" />

        <!-- 3-Card Related Silo Hub (Next Architecture & Business Pathways) -->
        <RelatedSiloPosts posts={relatedSiloPosts} currentCategory={post.data.category} lang="en" />

        <!-- Social Share & Ready-to-Post Media Box -->
        <!-- Author Profile Card (E-E-A-T Authority) -->
        <div class="my-8 p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 not-prose flex flex-col sm:flex-row items-center sm:items-start gap-5 shadow-sm">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-slate-900 to-rose-700 flex items-center justify-center text-white font-extrabold text-xl shadow-md shrink-0">
            BT
          </div>
          <div class="space-y-2 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <h3 class="font-extrabold text-lg text-slate-950 dark:text-white">
                <a href="/en/about/" class="hover:text-rose-600 transition-colors">Bijak Technology Editorial Desk</a>
              </h3>
              <span class="text-[10px] font-bold uppercase tracking-wider bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-400 px-2 py-0.5 rounded">
                Systems Architecture &amp; Engineering Desk
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-sans">
              Curated by our collective of software architects, infrastructure engineers, and open-source practitioners. Focused on rigorous server benchmarks, enterprise cloud data sovereignty, and reproducible engineering blueprints.
            </p>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-1 text-xs font-semibold">
              <a href="https://samkarsa.com" target="_blank" rel="noopener noreferrer" class="text-rose-600 dark:text-rose-400 hover:underline">
                Samkarsa Enterprise Solutions &rarr;
              </a>
              <span class="text-slate-300 dark:text-slate-700">•</span>
              <a href="https://github.com/bijaktechnology" target="_blank" rel="noopener noreferrer" class="text-slate-700 dark:text-slate-300 hover:text-rose-600 hover:underline">
                GitHub Repositories &rarr;
              </a>
              <span class="text-slate-300 dark:text-slate-700">•</span>
              <a href="/en/contact/" class="text-sky-600 dark:text-sky-400 hover:underline">
                Contact Editorial Desk &rarr;
              </a>
            </div>
          </div>
        </div>

        <SocialReadyBox 
          title={post.data.title}
          url={`https://bijaktechnology.com/en/blog/${post.id}`}
          social={post.data.social}
          lang="en"
        />

        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Related Tags:</span>
              {post.data.tags.map(tag => (
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs px-3 py-1 rounded-lg font-semibold border border-slate-300/80 dark:border-slate-700 hover:bg-rose-500 hover:text-white transition-all cursor-default">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Navigation Bottom Bar -->
      <div class="mt-8 flex justify-between items-center px-2">
        <a href="/en/blog" class="inline-flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Blog Archive
        </a>
      </div>
    </main>

    <!-- Sidebar -->
    <aside class="lg:col-span-4 space-y-8">
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-300/80 dark:border-slate-800 shadow-sm sticky top-6">
        <div class="flex items-center gap-2 mb-6 pb-3 border-b border-slate-200 dark:border-slate-800">
          <div class="w-2.5 h-6 bg-rose-600 rounded-full"></div>
          <h3 class="font-extrabold text-lg text-slate-950 dark:text-white">
            Recommended Stories
          </h3>
        </div>
        
        <div class="space-y-6">
          {recentPosts.map((p) => (
            <div class="group border-b border-slate-200 dark:border-slate-800/60 pb-5 last:border-0 last:pb-0 flex gap-3.5 items-start">
              <a href={`/en/blog/${p.id}/`} class="w-20 h-16 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shrink-0 block mt-0.5">
                <img
                  src={getPostImage(p)}
                  alt={p.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="160"
                  height="128"
                />
              </a>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md inline-block">
                  {p.data.category}
                </span>
                <h4 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-slate-200 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors leading-snug mt-1.5 line-clamp-2">
                  <a href={`/en/blog/${p.id}/`}>{p.data.title}</a>
                </h4>
                <div class="text-[11px] text-slate-600 dark:text-slate-400 font-medium mt-1">
                  {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Samkarsa CTA (English) -->
        <div class="mt-8 p-5 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl border border-slate-700 shadow-lg">
          <h4 class="font-extrabold text-base mb-2 text-rose-400">
            Enterprise Digital Transformation
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Need architecture consulting or regulatory-compliant enterprise Web3 &amp; ERP systems?
          </p>
          <a href="https://samkarsa.com" target="_blank" class="inline-flex items-center gap-1.5 w-full justify-center bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition-all shadow-md">
            Visit Samkarsa &rarr;
          </a>
        </div>

        <!-- Hostinger Sidebar Widget (English) -->
        <div class="mt-8">
          <HostingerBox category={post.data.category} variant="sidebar" lang="en" />
        </div>

        <!-- Sticky Sidebar AdSense Display Unit -->
        <AdSenseUnit format="rectangle" minHeight="min-h-[250px]" className="mt-8" />
      </div>
    </aside>
  </div>
</Layout>
