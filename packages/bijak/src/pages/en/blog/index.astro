---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdSenseUnit from '../../../components/AdSenseUnit.astro';
import HostingerBox from '../../../components/HostingerBox.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map(post => post.data.category))];
---

<Layout title="All Articles & Stories" description="Complete archive of Bijak Technology articles" lang="en">
  <div class="space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">
        Archive of Tech, ERP & Business Reports
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        In-depth engineering reviews, local retail digitalization, and cloud architecture journals.
      </p>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/en/blog" class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-rose-600 text-white shadow-sm">
        All Categories
      </a>
      {categories.map(cat => (
        <a href={`/blog?category=${cat}`} class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-rose-500 transition-colors">
          {cat}
        </a>
      ))}
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <article class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div class="space-y-2.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-rose-600">
              {post.data.category}
            </span>
            <h2 class="font-bold text-base text-slate-900 dark:text-white leading-snug hover:text-rose-600 transition-colors">
              <a href={`/en/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <div class="text-[11px] text-slate-400 pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 font-mono">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </div>
        </article>
      ))}
    </div>

    <AdSenseUnit className="my-10" />

    <HostingerBox variant="in-article" />
  </div>
</Layout>
