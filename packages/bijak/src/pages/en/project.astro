---
import Layout from '../../layouts/Layout.astro';

const title = "Projects & Solutions Portfolio";
const description = "Comprehensive catalog of open-source repositories, retail software systems, and cloud architectures built by Bijak Technology.";

let orgRepos = [];
let errorMsg = "";

try {
  const orgReposRes = await fetch('https://api.github.com/orgs/bijaktechnology/repos?sort=updated&per_page=10', {
    headers: { 'User-Agent': 'Astro-App-Build' }
  });
  if (orgReposRes.ok) {
    orgRepos = await orgReposRes.json();
  } else {
    errorMsg = "Unable to fetch live repositories. Displaying featured projects.";
  }
} catch (e) {
  errorMsg = "Network timeout connecting to GitHub API. Displaying featured projects.";
}

const fallbackRepos = [
  {
    name: "storaji",
    description: "Lightweight, responsive inventory and stock management system designed for grassroots merchant efficiency.",
    language: "Go",
    stargazers_count: 124,
    forks_count: 32,
    html_url: "https://github.com/bijaktechnology/storaji"
  },
  {
    name: "blonjo-pos",
    description: "Point of Sale (POS) application featuring integrated dynamic QRIS, receipt printers, and multi-warehouse stock sync.",
    language: "TypeScript",
    stargazers_count: 89,
    forks_count: 18,
    html_url: "https://github.com/bijaktechnology/blonjo-pos"
  },
  {
    name: "frappe-indonesia-compliance",
    description: "Localization module for ERPNext v16 supporting Indonesian statutory compliance, PPh 21 TER, and e-Faktur integration.",
    language: "Python",
    stargazers_count: 215,
    forks_count: 64,
    html_url: "https://github.com/bijaktechnology/frappe-indonesia-compliance"
  }
];

const displayRepos = orgRepos.length > 0 ? orgRepos : fallbackRepos;
---

<Layout 
  title={title} 
  description={description}
  lang="en"
  alternateId="/project/"
  alternateEn="/en/project/"
>
  <div class="max-w-4xl mx-auto space-y-10 py-6">
    <header class="border-b-2 border-neutral-900 dark:border-neutral-700 pb-6 text-center">
      <span class="text-xs uppercase tracking-widest font-sans font-bold text-rose-600 dark:text-rose-400">Engineering Portfolio</span>
      <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight mt-2 mb-3 text-neutral-900 dark:text-neutral-100">
        Open Source & Systems
      </h1>
      <p class="text-sm font-serif italic text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto">
        Public engineering repositories, deployment tools, and production-tested architectures maintaining data sovereignty.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {displayRepos.map(repo => (
        <a 
          href={repo.html_url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block p-6 border-2 border-neutral-900 dark:border-neutral-700 bg-white dark:bg-neutral-900 hover:shadow-[4px_4px_0px_0px_rgba(225,29,72,1)] transition-all"
        >
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-bold font-mono text-neutral-900 dark:text-neutral-100">{repo.name}</h2>
            {repo.language && (
              <span class="text-xs font-mono font-semibold px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 rounded">
                {repo.language}
              </span>
            )}
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 line-clamp-2">
            {repo.description || "Production toolchain engineered by Bijak Technology."}
          </p>
          <div class="flex items-center space-x-4 text-xs font-mono text-neutral-500">
            <span>★ {repo.stargazers_count ?? 0}</span>
            <span>⑂ {repo.forks_count ?? 0}</span>
            <span class="text-rose-600 font-semibold ml-auto">View Repo →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
