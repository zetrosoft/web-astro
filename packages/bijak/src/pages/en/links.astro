---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdSenseUnit from '../../components/AdSenseUnit.astro';
import { getPostImage } from '../../utils/heroImage';

const postsEn = await getCollection('blog_en');
const postsId = await getCollection('blog');
const enMap = new Map(postsEn.map(p => [p.id, p]));
const allIds = new Set([...postsEn.map(p => p.id), ...postsId.map(p => p.id)]);

const validPosts = Array.from(allIds)
  .filter(id => id !== 'agentic-ai-adaptation-cheap-lightweight-efficient-systems')
  .map(id => enMap.get(id) || postsId.find(p => p.id === id))
  .filter(Boolean) as typeof postsEn;

const sortedPosts = validPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 24);
---

<Layout 
  title="Official Link Hub & Articles Directory - Bijak Technology"
  description="Explore full technical breakdowns, architecture blueprints, and benchmark matrices featured on Bijak Technology's official social media channels."
>
  <div class="max-w-2xl mx-auto px-4 py-6 sm:py-10 space-y-8">
    
    <!-- Profile & Branding Header -->
    <header class="text-center space-y-4">
      <div class="relative inline-block">
        <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto rounded-3xl bg-gradient-to-tr from-rose-600 via-rose-500 to-amber-500 p-1 shadow-xl shadow-rose-500/20">
          <div class="w-full h-full bg-white dark:bg-slate-900 rounded-[22px] flex items-center justify-center p-3">
            <img 
              src="/images/logo-bijak-horizontal.png" 
              alt="Bijak Technology" 
              class="max-w-full max-h-full object-contain"
            />
          </div>
        </div>
        <span class="absolute -bottom-1 -right-1 bg-emerald-500 text-white p-1.5 rounded-full shadow-md" title="Official Verified Link Hub">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </span>
      </div>

      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight">
          Bijak Technology
        </h1>
        <p class="text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400 mt-1 max-w-md mx-auto">
          System Architecture, Cloud VPS, Enterprise ERP &amp; Scalable Engineering
        </p>
      </div>

      <!-- Quick Social Icons -->
      <div class="flex items-center justify-center gap-2 pt-2">
        <a href="https://www.instagram.com/bijaktechno" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-slate-700 transition-all shadow-sm" title="Instagram @bijaktechno">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
        </a>
        <a href="https://www.threads.net/@samkarsax" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-slate-700 transition-all shadow-sm" title="Threads @samkarsax">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.186 24C5.467 24 0 18.533 0 11.814 0 5.094 5.467 0 12.186 0c6.72 0 12.187 5.094 12.187 11.814 0 .341-.013.682-.04 1.022-.245 3.092-1.77 5.756-4.298 7.502-2.528 1.745-5.69 2.502-8.899 2.13-1.637-.19-3.21-.77-4.57-1.683l1.458-2.148c1.077.724 2.32 1.185 3.612 1.336 2.54.295 5.044-.305 7.046-1.688 2-1.382 3.208-3.488 3.4-5.927.02-.27.032-.54.032-.81 0-5.26-4.275-9.535-9.535-9.535-5.26 0-9.535 4.275-9.535 9.535 0 5.26 4.275 9.535 9.535 9.535 1.25 0 2.47-.245 3.626-.727l1.042 2.385C16.326 23.633 14.28 24 12.186 24z"></path></svg>
        </a>
        <a href="https://github.com/bijaktechnology" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-all shadow-sm" title="GitHub Bijak Technology">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
        </a>
        <a href="https://samkarsa.com" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-slate-700 transition-all shadow-sm font-bold text-xs" title="Samkarsa ERP Enterprise">
          B2B
        </a>
      </div>
    </header>

    <!-- Top Core Action Links -->
    <div class="space-y-3">
      <a 
        href="/en/" 
        class="flex items-center justify-between p-4 rounded-2xl bg-gradient-to-r from-rose-600 to-rose-500 text-white font-bold text-sm shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:scale-[1.01] transition-all"
      >
        <span class="flex items-center gap-3">
          <span class="text-lg">🌐</span>
          <span>Visit Bijak Technology Global Portal</span>
        </span>
        <span>&rarr;</span>
      </a>

      <a 
        href="/go/hostinger/" 
        class="flex items-center justify-between p-4 rounded-2xl bg-slate-900 dark:bg-slate-800 text-white font-bold text-sm border border-slate-700 hover:border-rose-500 hover:scale-[1.01] transition-all shadow-md"
      >
        <span class="flex items-center gap-3">
          <span class="text-lg">☁️</span>
          <span>Cloud KVM VPS Deals &amp; Discounts</span>
        </span>
        <span class="text-xs bg-rose-600 px-2 py-0.5 rounded-md font-mono">Special</span>
      </a>

      <a 
        href="https://samkarsa.com" 
        target="_blank"
        class="flex items-center justify-between p-4 rounded-2xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-sm border border-slate-200 dark:border-slate-800 hover:border-rose-500 hover:scale-[1.01] transition-all shadow-sm"
      >
        <span class="flex items-center gap-3">
          <span class="text-lg">🏭</span>
          <span>Enterprise ERPNext v16 Consulting</span>
        </span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- AdSense Slot 1 -->
    <AdSenseUnit className="my-6" />

    <!-- Articles Feed Section -->
    <section class="space-y-5">
      <div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-6 bg-rose-600 rounded-full"></div>
          <h2 class="text-base sm:text-lg font-extrabold text-slate-950 dark:text-white tracking-tight">
            Featured Articles from Social Media
          </h2>
        </div>
        <span class="text-xs font-semibold text-slate-500">
          {recentPosts.length} Guides
        </span>
      </div>

      <!-- Quick Search Bar -->
      <div class="relative">
        <input 
          id="link-search"
          type="text" 
          placeholder="Search articles you saw on Instagram..."
          class="w-full pl-10 pr-4 py-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-sm font-medium text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 shadow-sm"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      <!-- Article Card Grid -->
      <div id="articles-container" class="space-y-3">
        {recentPosts.map((post) => (
          <a 
            href={`/en/blog/${post.id}/`}
            class="article-item group flex gap-4 p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 hover:border-rose-500 hover:shadow-md transition-all duration-300"
            data-title={post.data.title.toLowerCase()}
            data-category={post.data.category.toLowerCase()}
          >
            <!-- Thumbnail 16:9 matching IG image -->
            <div class="w-28 sm:w-36 aspect-video rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0 border border-slate-200 dark:border-slate-700">
              <img 
                src={getPostImage(post)} 
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                width="240"
                height="135"
              />
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-extrabold uppercase tracking-wider text-rose-700 dark:text-rose-400 bg-rose-100/70 dark:bg-rose-950/40 px-2 py-0.5 rounded-md inline-block">
                  {post.data.category}
                </span>
                <h3 class="font-bold text-xs sm:text-sm text-slate-900 dark:text-slate-100 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors mt-1.5 leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
              </div>
              <div class="flex items-center justify-between text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-2">
                <span>Read Guide &rarr;</span>
                <span class="text-slate-400 font-normal">{post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' })}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div id="no-results" class="hidden text-center py-8 text-slate-500 text-xs font-medium">
        No articles found matching that keyword. Try another term or view <a href="/en/blog/" class="text-rose-600 underline">all blog archives</a>.
      </div>
    </section>

    <!-- Bottom AdSense Display Unit -->
    <AdSenseUnit format="auto" className="my-6" />

    <!-- Footer -->
    <footer class="pt-6 border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 space-y-2">
      <p>&copy; {new Date().getFullYear()} Bijak Technology • All rights reserved.</p>
      <div class="flex items-center justify-center gap-3 font-semibold text-slate-600 dark:text-slate-400">
        <a href="/en/privacy-policy" class="hover:underline">Privacy Policy</a>
        <span>•</span>
        <a href="/en/terms" class="hover:underline">Terms</a>
        <span>•</span>
        <a href="/en/blog" class="hover:underline">All Articles</a>
      </div>
    </footer>

  </div>

  <script is:inline>
    const searchInput = document.getElementById('link-search');
    const articles = document.querySelectorAll('.article-item');
    const noResults = document.getElementById('no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        articles.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const category = card.getAttribute('data-category') || '';
          const match = title.includes(query) || category.includes(query);
          
          if (match) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          noResults?.classList.remove('hidden');
        } else {
          noResults?.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
