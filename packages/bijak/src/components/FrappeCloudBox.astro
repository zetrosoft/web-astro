---
// packages/bijak/src/components/FrappeCloudBox.astro
// Modern Conversion-Oriented Affiliate Card for Frappe Cloud Official Managed Platform
// Referrer: https://cloud.frappe.io/dashboard/signup?referrer=d8b2ecbf via /go/frappe/

interface Props {
  variant?: 'in-article' | 'callout' | 'sidebar';
  lang?: 'id' | 'en';
}

const { variant = 'in-article', lang = 'id' } = Astro.props;
const isEn = lang === 'en';
const referralUrl = '/go/frappe/';

const title = isEn
  ? 'Frappe Cloud: Official Managed Hosting for ERPNext & Custom Apps'
  : 'Frappe Cloud: Platform Managed Hosting Resmi untuk ERPNext & Frappe Apps';

const badge = isEn
  ? 'Official Managed Cloud • Zero Sysadmin Overhead'
  : 'Official Managed Cloud • Bebas Beban Sysadmin';

const description = isEn
  ? 'Deploy production-grade ERPNext v16, HRMS, and custom Frappe applications without the complexity of manual Docker benches, MariaDB tuning, or Redis configuration. Engineered directly by the creators of Frappe Framework.'
  : 'Jalankan ERPNext v16, HRMS, dan aplikasi Frappe kustom untuk skala produksi tanpa kerumitan konfigurasi Docker bench, tuning MariaDB, atau orkestrasi Redis worker manual. Dikelola langsung oleh tim pengembang inti Frappe Technologies.';

const features = isEn ? [
  { icon: '⚡', title: '1-Click Deployment', desc: 'Ready-to-use ERPNext instances deployed in under 2 minutes.' },
  { icon: '🔄', title: 'Zero-Downtime Updates', desc: 'Effortless version upgrades with automated schema migrations.' },
  { icon: '🛡️', title: 'Automated S3 Backups', desc: 'Daily encrypted offsite snapshots with 1-click disaster recovery.' },
  { icon: '🧪', title: 'Staging & Dev Sandboxes', desc: 'Fork live production sites to test custom DocTypes safely.' }
] : [
  { icon: '⚡', title: 'Deploy Instan 1-Klik', desc: 'Instance ERPNext dan bench produksi aktif dalam waktu kurang dari 2 menit.' },
  { icon: '🔄', title: 'Update Tanpa Downtime', desc: 'Pembaruan versi berkala dengan migrasi skema database otomatis dan aman.' },
  { icon: '🛡️', title: 'Auto-Backup Terenkripsi S3', desc: 'Pencadangan snapshot berkala dengan pemulihan bencana 1-klik teruji.' },
  { icon: '🧪', title: 'Sandbox Staging Terisolasi', desc: 'Kloning sistem live untuk uji coba DocType atau Server Script baru.' }
];

const ctaText = isEn
  ? 'Start Free on Frappe Cloud'
  : 'Mulai Deploy di Frappe Cloud Resmi';

const subCtaText = isEn
  ? 'Directly managed by Frappe Technologies • 100% Open-Source Freedom'
  : 'Dikelola langsung oleh Frappe Technologies • Kedaulatan Penuh Open Source';
---

{variant === 'in-article' ? (
  <aside class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-slate-900 via-sky-950 to-slate-950 text-white shadow-xl border border-sky-500/30 not-prose relative overflow-hidden">
    <!-- Ambient Background Glows -->
    <div class="absolute -right-20 -top-20 w-72 h-72 bg-sky-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <!-- Top Badge & Label -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-sky-500/20 text-sky-300 border border-sky-400/30">
          <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z"/>
          </svg>
          {badge}
        </span>
        <span class="text-xs font-mono text-sky-200/90 bg-sky-950/60 px-3 py-1 rounded-lg border border-sky-800/60">
          Managed by Frappe Core Team
        </span>
      </div>

      <!-- Main Headline & Narrative Copy -->
      <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-3">
        {title}
      </h3>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
        {description}
      </p>

      <!-- Key Value Propositions Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {features.map(f => (
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-sky-400/30 transition-colors">
            <div class="flex items-start gap-2.5">
              <span class="text-lg leading-none shrink-0">{f.icon}</span>
              <div>
                <h4 class="text-xs font-bold text-sky-200">{f.title}</h4>
                <p class="text-[11px] text-slate-300 leading-snug mt-0.5">{f.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Call to Action Area -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
        <a
          href={referralUrl}
          target="_blank"
          rel="noopener sponsored"
          data-mcp-action="signup_frappe_cloud_partner"
          data-mcp-description="Deploy Managed ERPNext Instance on Frappe Cloud"
          data-mcp-params="referrer=d8b2ecbf"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-sky-500 via-blue-600 to-indigo-600 hover:from-sky-400 hover:via-blue-500 hover:to-indigo-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-sky-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>{ctaText}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <span class="text-[11px] text-slate-400 text-center sm:text-left font-mono">
          {subCtaText}
        </span>
      </div>
    </div>
  </aside>
) : (
  <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-900 via-sky-950 to-slate-950 text-white border border-sky-500/30 shadow-lg text-center not-prose">
    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-sky-500/20 text-sky-300 border border-sky-400/30 mb-3">
      Frappe Cloud
    </span>
    <h4 class="text-base font-bold text-white mb-2 leading-snug">
      {title}
    </h4>
    <p class="text-xs text-slate-300 leading-relaxed mb-4">
      {isEn
        ? 'Skip sysadmin overhead. Deploy ERPNext v16 on Frappe Cloud with automated staging, S3 snapshots, and push-button upgrades.'
        : 'Hilangkan beban sysadmin. Deploy ERPNext v16 di Frappe Cloud resmi dengan staging otomatis, snapshot S3, dan update 1-klik.'}
    </p>
    <a
      href={referralUrl}
      target="_blank"
      rel="noopener sponsored"
      class="block w-full py-2.5 px-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs tracking-wide transition-all shadow-md"
    >
      {ctaText}
    </a>
  </div>
)}
