---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-950 via-slate-900 to-teal-950 text-white border border-emerald-500/30 shadow-xl not-prose relative overflow-hidden ${className}`}>
  <div class="relative z-10">
    <!-- Header Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
        Liputan Lapangan • Boyolali (Radius 20 KM)
      </span>
      <span class="text-xs font-mono text-emerald-300/80">
        Blonjo POS • Pembayaran QRIS &amp; Pesan WhatsApp
      </span>
    </div>

    <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-3">
      Toko Sembako Kusuma: Grosir &amp; Eceran Karanggeneng Boyolali
    </h3>

    <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
      Pusat kulakan bahan pokok dan sembako terpercaya bagi masyarakat Karanggeneng, Boyolali dan sekitarnya. Melayani mitra pedagang warung, pelaku katering, dan kebutuhan belanja harian dengan harga bersaing, transaksi kasir cepat via <strong>Aplikasi Blonjo POS</strong>, kemudahan pembayaran digital via <strong>QRIS</strong>, serta layanan <strong>pesan via WhatsApp</strong>.
    </p>

    <!-- Details Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
        <div class="text-xs font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
          Lokasi Fisik Toko
        </div>
        <p class="text-xs text-slate-200 leading-relaxed">
          <strong>Jl. Sandang Lawe No. 22</strong>, RT 02 / RW 01, Karanggeneng, Kec. Boyolali, Kabupaten Boyolali, Jawa Tengah 57312.
        </p>
        <div class="text-[11px] text-emerald-400 font-mono">
          Jangkauan: Radius 20 KM se-Kabupaten Boyolali
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
        <div class="text-xs font-bold text-teal-300 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Teknologi Kasir &amp; Pembayaran
        </div>
        <p class="text-xs text-slate-200 leading-relaxed">
          Didukung <strong>Blonjo POS</strong>, menerima pembayaran non-tunai instan via <strong>QRIS</strong> (semua bank &amp; e-wallet), serta layanan <strong>pesan via WhatsApp</strong> langsung kirim.
        </p>
        <div class="text-[11px] text-teal-400 font-mono">
          Jam Buka: 05:30 – 20:00 WIB (Buka Setiap Hari)
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a
        href="https://maps.google.com/?q=Toko+Sembako+Kusuma+Karanggeneng+Boyolali"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm tracking-wide shadow-lg shadow-emerald-500/25 transition-all"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
        <span>Buka Rute Google Maps</span>
      </a>
      <a
        href="https://wa.me/6281219987377?text=Halo%20Toko%20Sembako%20Kusuma,%20saya%20ingin%20cek%20daftar%20harga%20sembako"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm tracking-wide border border-white/20 transition-all"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.825z"/></svg>
        <span>Pesan via WhatsApp</span>
      </a>
    </div>
  </div>
</div>
