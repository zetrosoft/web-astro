---
interface Props {
  title: string;
  url: string;
  social?: {
    twitter_thread?: string[];
    linkedin?: string;
    threads?: string;
    facebook?: string;
  };
  lang?: 'id' | 'en';
}

const { title, url, social, lang = 'id' } = Astro.props;

const isEn = lang === 'en';
const shareLabel = isEn ? 'Share This Insight' : 'Bagikan Wawasan Ini';
const shareDesc = isEn ? 'Distribute this article across your professional network' : 'Sebarkan artikel ini ke jaringan profesional Anda';
const copyLinkText = isEn ? 'Copy Link' : 'Salin Tautan';
const readyCopyTitle = isEn ? 'Ready-to-Post Social Media Content' : 'Materi Promosi Media Sosial Siap Tayang';
const readyCopyDesc = isEn 
  ? 'Curated social media drafts for X, LinkedIn, Threads, and Facebook. Click copy and publish instantly.'
  : 'Draf konten kurasi siap posting untuk X, LinkedIn, Threads, dan Facebook. Klik salin dan langsung publikasikan.';

// Susun teks thread twitter jika ada
const fullTwitterThread = social?.twitter_thread && social.twitter_thread.length > 0
  ? social.twitter_thread.map((t, idx) => `[${idx + 1}/${social.twitter_thread.length}]\n${t}`).join('\n\n')
  : `${title}\n\n${url}`;

const firstTweet = social?.twitter_thread?.[0] || title;
---

<div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
  <!-- Bar Header & Tombol Share Cepat -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">{shareLabel}</div>
      <div class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 font-medium">{shareDesc}</div>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <!-- Share LinkedIn -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Share to LinkedIn"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9Z"/></svg>
        LinkedIn
      </a>

      <!-- Share X / Twitter -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(`${firstTweet} via @bijaktech`)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-black text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Share to X"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X
      </a>

      <!-- Share Threads -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://threads.net/intent/post?text=${encodeURIComponent(`${firstTweet}\n\n${url}`)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Share to Threads"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.186 24C5.514 24 0 18.54 0 12.002 0 5.463 5.514 0 12.186 0c6.438 0 11.836 5.093 12.164 11.455h-2.738c-.31-4.858-4.498-8.717-9.426-8.717-5.234 0-9.447 4.214-9.447 9.264 0 5.05 4.213 9.263 9.447 9.263 3.992 0 7.375-2.527 8.718-6.104H12.186v-2.738h11.758C23.978 18.89 18.665 24 12.186 24z"/></svg>
        Threads
      </a>

      <!-- Share Facebook -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Share to Facebook"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        FB
      </a>

      <!-- Share WhatsApp -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${title}\n\n${url}`)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Share to WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.86-.38-4.11-1.1l-.29-.17-3.11.82.83-3.03-.19-.31a8.16 8.16 0 0 1-1.25-4.47c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/></svg>
        WA
      </a>

      <!-- Copy Link Button -->
      <button
        id="copy-link-btn"
        type="button"
        data-url={url}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold border border-slate-300/80 dark:border-slate-700 transition-all cursor-pointer"
        aria-label="Salin Tautan"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        <span id="copy-btn-text">{copyLinkText}</span>
      </button>
    </div>
  </div>

  <!-- Expandable Ready-to-Post Social Copy Section -->
  {social && (
    <details class="group mt-6 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
      <summary class="flex items-center justify-between p-4 cursor-pointer select-none hover:bg-slate-100/70 dark:hover:bg-slate-800 transition-colors">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-sm">
            ⚡
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">{readyCopyTitle}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">{readyCopyDesc}</div>
          </div>
        </div>
        <svg class="w-4 h-4 text-slate-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>

      <div class="p-4 pt-0 space-y-4 border-t border-slate-200/80 dark:border-slate-800/80 mt-2">
        <!-- 1. Twitter / X 4-Thread -->
        {social.twitter_thread && social.twitter_thread.length > 0 && (
          <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-slate-900 dark:bg-slate-100"></span>
                Twitter / X Thread ({social.twitter_thread.length} Tweets)
              </span>
              <button
                type="button"
                class="copy-social-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-rose-500 hover:text-white font-semibold text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
                data-text={fullTwitterThread}
              >
                📋 Salin Thread
              </button>
            </div>
            <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300 font-mono">
              {social.twitter_thread.map((tw, idx) => (
                <div class="p-2 rounded bg-slate-50 dark:bg-slate-950/50 border border-slate-100 dark:border-slate-800/60">
                  <span class="font-bold text-rose-500">{idx + 1}/{social.twitter_thread!.length}:</span> {tw}
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- 2. LinkedIn Post -->
        {social.linkedin && (
          <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#0a66c2]"></span>
                LinkedIn (B2B Thought Leadership)
              </span>
              <button
                type="button"
                class="copy-social-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#0a66c2] hover:text-white font-semibold text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
                data-text={social.linkedin}
              >
                📋 Salin Post
              </button>
            </div>
            <pre class="whitespace-pre-wrap font-sans text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-h-40 overflow-y-auto">{social.linkedin}</pre>
          </div>
        )}

        <!-- 3. Instagram Threads -->
        {social.threads && (
          <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-black dark:bg-white"></span>
                Instagram Threads
              </span>
              <button
                type="button"
                class="copy-social-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-black hover:text-white font-semibold text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
                data-text={social.threads}
              >
                📋 Salin Threads
              </button>
            </div>
            <pre class="whitespace-pre-wrap font-sans text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-h-36 overflow-y-auto">{social.threads}</pre>
          </div>
        )}

        <!-- 4. Facebook Community Post -->
        {social.facebook && (
          <div class="bg-white dark:bg-slate-900 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#1877F2]"></span>
                Facebook Community
              </span>
              <button
                type="button"
                class="copy-social-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-[#1877F2] hover:text-white font-semibold text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
                data-text={social.facebook}
              >
                📋 Salin FB
              </button>
            </div>
            <pre class="whitespace-pre-wrap font-sans text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-h-36 overflow-y-auto">{social.facebook}</pre>
          </div>
        )}
      </div>
    </details>
  )}
</div>

<script is:inline>
  (function() {
    // Tombol Salin Tautan
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    if (copyLinkBtn && copyBtnText) {
      copyLinkBtn.addEventListener('click', async function() {
        const url = copyLinkBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          const orig = copyBtnText.innerText;
          copyBtnText.innerText = 'Tersalin!';
          copyLinkBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          setTimeout(() => {
            copyBtnText.innerText = orig;
            copyLinkBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          }, 2000);
        } catch (e) {}
      });
    }

    // Tombol Salin Media Sosial
    const socialBtns = document.querySelectorAll('.copy-social-btn');
    socialBtns.forEach(btn => {
      btn.addEventListener('click', async function() {
        const text = btn.getAttribute('data-text');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.innerText;
          btn.innerText = '✅ Tersalin!';
          btn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            btn.innerText = orig;
            btn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        } catch (e) {}
      });
    });
  })();
</script>
