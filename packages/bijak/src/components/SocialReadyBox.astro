---
interface Props {
  title: string;
  url: string;
  social?: {
    twitter_thread?: string[];
    linkedin?: string;
    threads?: string;
    facebook?: string;
  };
  lang?: 'id' | 'en';
}

const { title, url, social, lang = 'id' } = Astro.props;

const isEn = lang === 'en';
const shareLabel = isEn ? 'Share' : 'Bagikan';
const shareDesc = isEn ? 'Share this article or copy drafts for your social media' : 'Bagikan artikel ini atau salin draf siap posting ke media sosial';
const copyLinkText = isEn ? 'Copy Link' : 'Salin Tautan';

// Draf Twitter Thread
const fullTwitterThread = social?.twitter_thread && social.twitter_thread.length > 0
  ? social.twitter_thread.map((t, idx) => `[${idx + 1}/${social.twitter_thread.length}]\n${t}`).join('\n\n')
  : `${title}\n\n${url}`;

const firstTweet = social?.twitter_thread?.[0] || title;
const linkedinText = social?.linkedin || `${title}\n\nBaca ulasan lengkapnya di sini: ${url}`;
const threadsText = social?.threads || `${title}\n\n${url}`;
const facebookText = social?.facebook || `${title}\n\nSimak selengkapnya di: ${url}`;
---

<div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        {shareLabel}
      </div>
      <div class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 font-medium">{shareDesc}</div>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <!-- Button X / Twitter -> Buka Modal Post X -->
      <button
        type="button"
        class="open-social-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-black text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 cursor-pointer"
        data-platform="x"
        aria-label="Format post Twitter/X"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X (Thread)
      </button>

      <!-- Button LinkedIn -> Buka Modal Post LinkedIn -->
      <button
        type="button"
        class="open-social-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 cursor-pointer"
        data-platform="linkedin"
        aria-label="Format post LinkedIn"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9Z"/></svg>
        LinkedIn
      </button>

      <!-- Button Threads -> Buka Modal Post Threads -->
      <button
        type="button"
        class="open-social-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 cursor-pointer"
        data-platform="threads"
        aria-label="Format post Threads"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.186 24C5.514 24 0 18.54 0 12.002 0 5.463 5.514 0 12.186 0c6.438 0 11.836 5.093 12.164 11.455h-2.738c-.31-4.858-4.498-8.717-9.426-8.717-5.234 0-9.447 4.214-9.447 9.264 0 5.05 4.213 9.263 9.447 9.263 3.992 0 7.375-2.527 8.718-6.104H12.186v-2.738h11.758C23.978 18.89 18.665 24 12.186 24z"/></svg>
        Threads
      </button>

      <!-- Button Facebook -> Buka Modal Post FB -->
      <button
        type="button"
        class="open-social-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 cursor-pointer"
        data-platform="facebook"
        aria-label="Format post Facebook"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        FB
      </button>

      <!-- Button Medium -> Buka Modal Post Medium -->
      <button
        type="button"
        class="open-social-modal-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5 cursor-pointer"
        data-platform="medium"
        aria-label="Format post Medium"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
        Medium
      </button>

      <!-- Share WhatsApp Langsung -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${title}\n\n${url}`)}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-bold shadow-sm transition-all hover:-translate-y-0.5"
        aria-label="Bagikan via WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.86-.38-4.11-1.1l-.29-.17-3.11.82.83-3.03-.19-.31a8.16 8.16 0 0 1-1.25-4.47c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.13.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.22-.19-.47-.32"/></svg>
        WA
      </a>

      <!-- Copy Link Button -->
      <button
        id="copy-link-btn"
        type="button"
        data-url={url}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold border border-slate-300/80 dark:border-slate-700 transition-all cursor-pointer"
        aria-label="Salin Tautan"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        <span id="copy-btn-text">{copyLinkText}</span>
      </button>
    </div>
  </div>

  <!-- MODAL POPUP: Format-to-Post Siap Tayang -->
  <div id="social-modal-overlay" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-2xl rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Modal Header -->
      <div class="p-5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-950/40">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg font-bold">
            ⚡
          </div>
          <div>
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-wider">
              {isEn ? 'Social Media Share' : 'Bagikan ke Media Sosial'}
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">
              {isEn ? 'Copy text or open your social media directly' : 'Salin draf atau langsung buka platform pilihan Anda'}
            </p>
          </div>
        </div>

        <button id="close-modal-btn" type="button" class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-slate-500 transition-colors cursor-pointer" aria-label="Tutup Modal">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Tab Switcher Platforms -->
      <div class="flex items-center gap-1.5 p-3 px-5 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-950/20 overflow-x-auto">
        <button type="button" class="tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer" data-target="tab-x">
          Twitter / X (4-Thread)
        </button>
        <button type="button" class="tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer" data-target="tab-linkedin">
          LinkedIn B2B
        </button>
        <button type="button" class="tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer" data-target="tab-threads">
          Threads
        </button>
        <button type="button" class="tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer" data-target="tab-facebook">
          Facebook
        </button>
        <button type="button" class="tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer" data-target="tab-medium">
          Medium.com (Full Article + Tables)
        </button>
      </div>

      <!-- Modal Body (Content per Platform) -->
      <div class="p-5 overflow-y-auto flex-1 space-y-4">
        
        <!-- Panel 1: X Thread -->
        <div id="tab-x" class="platform-panel hidden space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-500">
              {isEn ? 'Up to 4 sequential tweets:' : 'Maksimal 4 Tweet berurutan:'}
            </span>
            <button
              type="button"
              class="copy-and-open-btn px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition-all cursor-pointer shadow-sm"
              data-text={fullTwitterThread}
              data-open-url={`https://twitter.com/intent/tweet?text=${encodeURIComponent(firstTweet)}&url=${encodeURIComponent(url)}`}
            >
              {isEn ? '📋 Copy Thread & Open X' : '📋 Salin Thread & Buka X'}
            </button>
          </div>
          <div class="space-y-2.5 font-mono text-xs">
            {social?.twitter_thread && social.twitter_thread.length > 0 ? (
              social.twitter_thread.map((tw, idx) => (
                <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800">
                  <span class="font-bold text-rose-500">Tweet {idx + 1}/4:</span>
                  <p class="mt-1 text-slate-700 dark:text-slate-300 font-sans leading-relaxed">{tw}</p>
                </div>
              ))
            ) : (
              <pre class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-950 font-sans text-xs whitespace-pre-wrap">{fullTwitterThread}</pre>
            )}
          </div>
        </div>

        <!-- Panel 2: LinkedIn -->
        <div id="tab-linkedin" class="platform-panel hidden space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-500">
              {isEn ? 'B2B Thought Leadership format:' : 'Format B2B Thought Leadership:'}
            </span>
            <button
              type="button"
              class="copy-and-open-btn px-3.5 py-1.5 rounded-xl bg-[#0a66c2] hover:bg-[#084e96] text-white text-xs font-bold transition-all cursor-pointer shadow-sm"
              data-text={linkedinText}
              data-open-url={`https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(linkedinText)}`}
            >
              {isEn ? '📋 Copy Post & Open LinkedIn' : '📋 Salin Post & Buka LinkedIn'}
            </button>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800">
            <pre class="font-sans text-xs text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">{linkedinText}</pre>
          </div>
        </div>

        <!-- Panel 3: Threads -->
        <div id="tab-threads" class="platform-panel hidden space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-500">
              {isEn ? 'Punchy Micro-Blogging format:' : 'Format Micro-Blogging Padat:'}
            </span>
            <button
              type="button"
              class="copy-and-open-btn px-3.5 py-1.5 rounded-xl bg-black hover:bg-slate-800 text-white text-xs font-bold transition-all cursor-pointer shadow-sm"
              data-text={threadsText}
              data-open-url={`https://threads.net/intent/post?text=${encodeURIComponent(threadsText)}`}
            >
              {isEn ? '📋 Copy & Open Threads' : '📋 Salin & Buka Threads'}
            </button>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800">
            <pre class="font-sans text-xs text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">{threadsText}</pre>
          </div>
        </div>

        <!-- Panel 4: Facebook -->
        <div id="tab-facebook" class="platform-panel hidden space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-500">
              {isEn ? 'Community / Educational Storytelling:' : 'Format Komunitas / Edukatif:'}
            </span>
            <button
              type="button"
              class="copy-and-open-btn px-3.5 py-1.5 rounded-xl bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-bold transition-all cursor-pointer shadow-sm"
              data-text={facebookText}
              data-open-url={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
            >
              {isEn ? '📋 Copy & Open Facebook' : '📋 Salin & Buka Facebook'}
            </button>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800">
            <pre class="font-sans text-xs text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">{facebookText}</pre>
          </div>
        </div>

        <!-- Panel 5: Medium.com Full Rich-Text / Import Ready -->
        <div id="tab-medium" class="platform-panel hidden space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-500">
              {isEn ? 'Medium-optimized format (Tables auto-converted to structured lists):' : 'Format khusus Medium.com (Tabel otomatis dikonversi menjadi daftar poin rapi):'}
            </span>
            <div class="flex items-center gap-2">
              <button
                id="copy-medium-rich-btn"
                type="button"
                data-canonical-url={url}
                data-article-title={title}
                class="px-3.5 py-1.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold transition-all cursor-pointer shadow-sm"
              >
                {isEn ? '📋 Copy Rich Article & Open Medium' : '📋 Salin Artikel Penuh & Buka Medium'}
              </button>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800 text-xs text-slate-700 dark:text-slate-300 space-y-2">
            <p class="font-semibold text-emerald-700 dark:text-emerald-400">
              💡 {isEn ? 'How to publish cleanly on Medium.com:' : 'Cara tayang rapi di Medium.com:'}
            </p>
            <ol class="list-decimal pl-5 space-y-1">
              <li>
                {isEn
                  ? 'Option A (URL Import): Use https://medium.com/p/import — our page now includes automatic Medium-compatible structured lists for every table and zero header logo pollution!'
                  : 'Opsi A (Import URL): Gunakan https://medium.com/p/import — halaman ini sudah dilengkapi daftar poin otomatis pengganti tabel & bebas gambar logo header!'}
              </li>
              <li>
                {isEn
                  ? 'Option B (1-Click Rich Copy): Click the green button above, then press Cmd+V / Ctrl+V directly inside the Medium editor (https://medium.com/new-story).'
                  : 'Opsi B (1-Klik Copy Paste): Klik tombol hijau di atas, lalu tekan Cmd+V / Ctrl+V langsung di halaman editor Medium (https://medium.com/new-story).'}
              </li>
            </ol>
          </div>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="p-4 px-6 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-between">
        <span>
          {isEn 
            ? 'Click copy above: text is automatically copied to clipboard and the composer page opens.'
            : 'Klik tombol salin di atas, teks otomatis tersalin ke clipboard dan halaman composer akan terbuka.'}
        </span>
        <span class="font-bold text-slate-400">Bijak Social Agency</span>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // Tombol Salin Tautan Cepat
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    if (copyLinkBtn && copyBtnText) {
      copyLinkBtn.addEventListener('click', async function() {
        const url = copyLinkBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          const orig = copyBtnText.innerText;
          copyBtnText.innerText = 'Tersalin!';
          copyLinkBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          setTimeout(() => {
            copyBtnText.innerText = orig;
            copyLinkBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          }, 2000);
        } catch (e) {}
      });
    }

    // Modal Manajemen
    const modal = document.getElementById('social-modal-overlay');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const openBtns = document.querySelectorAll('.open-social-modal-btn');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.platform-panel');

    function switchTab(targetId) {
      tabBtns.forEach(btn => {
        if (btn.getAttribute('data-target') === targetId) {
          btn.className = 'tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all bg-rose-600 text-white shadow-sm cursor-pointer';
        } else {
          btn.className = 'tab-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer';
        }
      });

      panels.forEach(panel => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    openBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const platform = btn.getAttribute('data-platform');
        let targetId = 'tab-x';
        if (platform === 'linkedin') targetId = 'tab-linkedin';
        else if (platform === 'threads') targetId = 'tab-threads';
        else if (platform === 'facebook') targetId = 'tab-facebook';
        else if (platform === 'medium') targetId = 'tab-medium';

        switchTab(targetId);
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const targetId = btn.getAttribute('data-target');
        switchTab(targetId);
      });
    });

    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      });
    }

    // Tombol "Salin & Buka"
    const copyAndOpenBtns = document.querySelectorAll('.copy-and-open-btn');
    copyAndOpenBtns.forEach(btn => {
      btn.addEventListener('click', async function() {
        const text = btn.getAttribute('data-text');
        const openUrl = btn.getAttribute('data-open-url');
        const origText = btn.innerText;

        try {
          if (text) {
            await navigator.clipboard.writeText(text);
          }
          btn.innerText = '✅ Tersalin! Membuka...';
          btn.classList.add('bg-emerald-600');

          setTimeout(() => {
            if (openUrl) {
              window.open(openUrl, '_blank', 'noopener,noreferrer');
            }
          }, 300);

          setTimeout(() => {
            btn.innerText = origText;
            btn.classList.remove('bg-emerald-600');
          }, 2500);
        } catch (err) {
          if (openUrl) {
            window.open(openUrl, '_blank', 'noopener,noreferrer');
          }
        }
      });
    });

    // Tombol Copy Rich HTML untuk Medium.com
    const copyMediumBtn = document.getElementById('copy-medium-rich-btn');
    if (copyMediumBtn) {
      copyMediumBtn.addEventListener('click', async function() {
        const articleEl = document.querySelector('main article');
        const canonicalUrl = copyMediumBtn.getAttribute('data-canonical-url') || window.location.href;
        const articleTitle = copyMediumBtn.getAttribute('data-article-title') || document.title;
        if (!articleEl) return;

        const clone = articleEl.cloneNode(true);
        // Hapus slot iklan & elemen non-artikel
        clone.querySelectorAll('.adsbygoogle, ins, script, style, .not-prose').forEach(el => el.remove());
        // Tampilkan ul.medium-table-digest dan hapus table HTML agar di Medium rapi sebagai bullet points
        clone.querySelectorAll('ul.medium-table-digest').forEach(ul => {
          ul.removeAttribute('style');
        });
        clone.querySelectorAll('table').forEach(tbl => tbl.remove());

        const htmlContent = `\x3Ch1\x3E${articleTitle}\x3C/h1\x3E` + clone.innerHTML + `\x3Chr\x3E\x3Cp\x3E\x3Cem\x3EOriginally published at \x3Ca href="${canonicalUrl}"\x3E${canonicalUrl}\x3C/a\x3E\x3C/em\x3E\x3C/p\x3E`;
        const plainContent = `${articleTitle}\n\n` + clone.innerText + `\n\nOriginally published at ${canonicalUrl}`;

        try {
          if (window.ClipboardItem) {
            const blobHtml = new Blob([htmlContent], { type: 'text/html' });
            const blobText = new Blob([plainContent], { type: 'text/plain' });
            await navigator.clipboard.write([new ClipboardItem({ 'text/html': blobHtml, 'text/plain': blobText })]);
          } else {
            await navigator.clipboard.writeText(plainContent);
          }
          const orig = copyMediumBtn.innerText;
          copyMediumBtn.innerText = '✅ Copied Rich Format! Opening Medium...';
          setTimeout(() => {
            window.open('https://medium.com/new-story', '_blank', 'noopener,noreferrer');
          }, 300);
          setTimeout(() => {
            copyMediumBtn.innerText = orig;
          }, 2500);
        } catch (e) {
          window.open('https://medium.com/p/import', '_blank', 'noopener,noreferrer');
        }
      });
    }
  })();
</script>
