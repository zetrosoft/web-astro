---
interface Props {
  category?: string;
  variant?: 'in-article' | 'sidebar';
  lang?: 'id' | 'en';
}

const { category = '', variant = 'in-article', lang = 'id' } = Astro.props;

const catLower = category.toLowerCase();
const isEn = lang === 'en';

let title = isEn 
  ? 'Hostinger Cloud VPS: Next-Gen KVM NVMe Computing'
  : 'Hostinger Cloud VPS: Komputasi KVM NVMe Generasi Baru';
let badge = isEn
  ? 'Official Partner • Special Discount'
  : 'Official Partner • Diskon Spesial';
let description = isEn
  ? 'Optimize your web applications and production servers with high-speed KVM NVMe cloud architecture, 99.9% uptime SLA, and 24/7 priority support.'
  : 'Optimalkan kinerja aplikasi web dan server produksi Anda dengan arsitektur cloud KVM NVMe berkecepatan tinggi, jaminan ketersediaan uptime 99.9%, dan dukungan teknis 24/7.';
let spec = 'KVM 2: 2 vCPU • 8GB RAM • 100GB NVMe • Dedicated IPv4 & IPv6';
let ctaText = isEn ? 'Claim Hostinger Partner Offer' : 'Klaim Penawaran Hostinger Partner';
const referralUrl = '/go/hostinger/';
let ctaUrl = referralUrl;

if (catLower.includes('ritel') || catLower.includes('sembako') || catLower.includes('umkm') || catLower.includes('toko') || catLower.includes('bisnis') || catLower.includes('retail')) {
  title = isEn 
    ? 'Hostinger Business: Independent Digital Catalog & POS Solution'
    : 'Hostinger Business: Solusi Website Katalog & Kasir Digital Mandiri';
  badge = isEn ? 'Retail Cloud Solution • Guided Setup' : 'Solusi Ritel Mandiri • Setup Terpandu';
  description = isEn
    ? 'Build your business profile and independent digital product catalog for wholesale and retail stores. Equipped with intuitive AI Site Builder, official email, and automated SSL.'
    : 'Bangun profil bisnis dan katalog produk digital mandiri untuk toko grosir maupun UMKM ritel Anda. Dilengkapi AI Website Builder yang intuitif, email bisnis resmi, dan perlindungan SSL otomatis untuk memperkuat kepercayaan pelanggan.';
  spec = isEn ? 'Free Domain 1 Year • Unlimited SSL • AI Site Builder • Professional Email' : 'Domain Gratis 1 Tahun • Unlimited SSL • AI Site Builder • Email Bisnis Profesional';
  ctaText = isEn ? 'Launch Business Retail Website' : 'Mulai Bangun Website Bisnis Ritel';
  ctaUrl = referralUrl;
} else if (catLower.includes('erp') || catLower.includes('enterprise') || catLower.includes('manufaktur') || catLower.includes('distribusi') || catLower.includes('distribution') || catLower.includes('manufacturing')) {
  title = isEn
    ? 'Hostinger VPS KVM 4: Resilient Server for Enterprise ERP Deployments'
    : 'Hostinger VPS KVM 4: Server Andal untuk Implementasi ERP Enterprise';
  badge = isEn ? 'Recommended by Samkarsa • KVM 4 Enterprise' : 'Rekomendasi Samkarsa.com • KVM 4 Enterprise';
  description = isEn
    ? 'Deploy enterprise-scale ERPNext implementations with complete infrastructure control. Features dedicated computing, ultra-fast NVMe storage, automated daily snapshots, and full private cloud data sovereignty.'
    : 'Jalankan implementasi ERPNext berskala perusahaan dengan kebebasan kontrol infrastruktur penuh. Menawarkan komputasi dedicated, performa penyimpanan NVMe ultra-cepat, snapshot harian otomatis, dan kedaulatan data private cloud yang aman.';
  spec = isEn ? '4 vCPU • 16GB RAM • 200GB NVMe Storage • 4TB Bandwidth • Full Root Access' : '4 vCPU • 16GB RAM • 200GB NVMe Storage • Bandwidth 4TB • Full Root Access';
  ctaText = isEn ? 'Configure VPS KVM 4 for ERP' : 'Konfigurasi VPS KVM 4 untuk ERP';
  ctaUrl = referralUrl;
} else if (catLower.includes('ai') || catLower.includes('tech') || catLower.includes('devops') || catLower.includes('docker') || catLower.includes('coolify')) {
  title = isEn
    ? 'Hostinger VPS KVM 2: Compute Platform for AI Agents & Automation'
    : 'Hostinger VPS KVM 2: Platform Komputasi AI Agent & Workflow Otomasi';
  badge = isEn ? 'Docker Ready • High Performance' : 'Siap Container Docker • Performa Cepat';
  description = isEn
    ? 'Deploy n8n automation engines, Coolify PaaS, FastAPI backends, and PostgreSQL pgvector databases. Reliable, high-throughput infrastructure for modern software engineering.'
    : 'Deploy engine otomasi n8n, PaaS mandiri Coolify, backend FastAPI, serta database PostgreSQL pgvector dengan alur kerja modern. Infrastruktur stabil dan fleksibel untuk kebutuhan riset rekayasa perangkat lunak.';
  spec = '2 vCPU • 8GB RAM • 100GB NVMe Storage • Dedicated IPv4 & IPv6';
  ctaText = isEn ? 'Deploy KVM 2 Compute Server' : 'Deploy Server Komputasi KVM 2';
  ctaUrl = referralUrl;
} else if (catLower.includes('blockchain') || catLower.includes('web3') || catLower.includes('avalanche') || catLower.includes('crypto')) {
  title = isEn
    ? 'Hostinger Cloud VPS: Dedicated Gateway & Indexer for Blockchain Networks'
    : 'Hostinger Cloud VPS: Node Gateway & Indexer Jaringan Blockchain';
  badge = isEn ? 'High-Availability Web3 • Low Latency' : 'High-Availability Web3 • Latensi Rendah';
  description = isEn
    ? 'Support indexer operations, Avalanche RPC nodes, and smart contract webhook listeners without downtime. Powered by L3/L4 DDoS mitigation and consistent throughput.'
    : 'Mendukung operasional backend indexer, node RPC Avalanche, dan listener webhook smart contract tanpa hambatan downtime. Ditenagai proteksi DDoS tingkat lanjut dan throughput jaringan yang konsisten.';
  spec = isEn ? 'Fast NVMe Array • L3/L4 DDoS Mitigation • 99.9% Uptime SLA' : 'Array NVMe Cepat • Proteksi DDoS L3/L4 • Jaminan Ketersediaan 99.9%';
  ctaText = isEn ? 'Set Up Web3 Node on Hostinger' : 'Siapkan Node Web3 di Hostinger';
  ctaUrl = referralUrl;
}
---

{variant === 'in-article' ? (
  <aside class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 text-white shadow-xl border border-indigo-500/30 not-prose relative overflow-hidden">
    <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
          {badge}
        </span>
        <span class="text-xs font-mono text-indigo-300/80">
          {isEn ? 'Coupon:' : 'Kupon:'} <a href={ctaUrl} target="_blank" rel="noopener sponsored" class="text-amber-300 hover:text-amber-200 font-bold tracking-wider underline">6X5PUTERARQL</a>
        </span>
      </div>

      <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-3">
        {title}
      </h3>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-5">
        {description}
      </p>

      <div class="p-3.5 rounded-2xl bg-white/5 border border-white/10 mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div class="text-xs text-indigo-200 font-mono flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          <span>{spec}</span>
        </div>
        <div class="text-xs font-bold text-amber-300 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/25 shrink-0">
          {isEn ? 'Discount Code:' : 'Kupon Diskon:'} <a href={ctaUrl} target="_blank" rel="noopener sponsored" class="font-mono text-amber-200 hover:text-white tracking-wider underline">6X5PUTERARQL</a>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
          href={ctaUrl}
          target="_blank"
          rel="noopener sponsored"
          data-mcp-action="claim_hostinger_kvm_partner_discount"
          data-mcp-description={title}
          data-mcp-params="coupon=6X5PUTERARQL"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold text-sm tracking-wide shadow-lg shadow-indigo-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>{ctaText}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <span class="text-[11px] text-slate-400 text-center sm:text-left">
          {isEn ? '30-Day Money-Back Guarantee • Instant Setup' : 'Garansi 30 Hari Uang Kembali • Setup Instan'}
        </span>
      </div>
    </div>
  </aside>
) : (
  <div class="p-5 rounded-2xl bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 text-white border border-indigo-500/30 shadow-lg text-center">
    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 mb-3">
      Hostinger Partner
    </span>
    <h4 class="text-base font-bold text-white mb-2 leading-snug">
      {title}
    </h4>
    <p class="text-xs text-slate-300 leading-relaxed mb-4">
      {isEn 
        ? <>Apply discount code <a href={ctaUrl} target="_blank" rel="noopener sponsored" class="text-amber-300 font-mono font-bold bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20 underline">6X5PUTERARQL</a> at checkout for exclusive savings.</>
        : <>Gunakan kode kupon <a href={ctaUrl} target="_blank" rel="noopener sponsored" class="text-amber-300 font-mono font-bold bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20 underline">6X5PUTERARQL</a> untuk potongan harga ekstra saat checkout.</>
      }
    </p>
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener sponsored"
      data-mcp-action="claim_hostinger_kvm_partner_discount"
      data-mcp-description={title}
      data-mcp-params="coupon=6X5PUTERARQL"
      class="block w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs tracking-wide transition-all shadow-md"
    >
      {ctaText}
    </a>
  </div>
)}
