---
interface Props {
  category?: string;
  variant?: 'in-article' | 'sidebar';
}

const { category = '', variant = 'in-article' } = Astro.props;

const catLower = category.toLowerCase();

let title = 'Hostinger Official Partner: VPS KVM NVMe Generasi Baru';
let badge = 'Official Partner • Diskon Spesial';
let description = 'Tingkatkan performa web dan server Anda dengan infrastruktur cloud NVMe berkecepatan tinggi, garansi uptime 99.9%, dan dukungan teknis 24/7.';
let spec = 'KVM 2: 2 vCPU • 8GB RAM • 100GB NVMe • Dedicated IP';
let ctaText = 'Klaim Diskon Hostinger Partner';
let ctaUrl = 'https://www.hostinger.co.id/?utm_source=bijaktechnology&utm_medium=affiliate&utm_campaign=partner-vps';

if (catLower.includes('ritel') || catLower.includes('sembako') || catLower.includes('umkm') || catLower.includes('toko') || catLower.includes('bisnis')) {
  title = 'Hostinger Business: Website Katalog & Kasir UMKM Mandiri';
  badge = 'Rekomendasi Ritel • Diskon Hingga 75%';
  description = 'Ingin toko grosir, toko kelontong, atau UMKM Anda memiliki website katalog produk resmi dan server kasir mandiri seperti Toko Sembako Kusuma? Mulai sekarang dengan mudah tanpa perlu paham koding!';
  spec = 'Gratis Domain 1 Tahun • Unlimited SSL • AI Website Builder • Email Bisnis';
  ctaText = 'Bangun Website UMKM Mulai Rp20rb-an/bln';
  ctaUrl = 'https://www.hostinger.co.id/web-hosting?utm_source=bijaktechnology&utm_medium=affiliate&utm_campaign=umkm-retail';
} else if (catLower.includes('erp') || catLower.includes('odoo') || catLower.includes('manufaktur') || catLower.includes('enterprise')) {
  title = 'Hostinger VPS KVM 4: Server Produksi ERPNext Skala Korporat';
  badge = 'Rekomendasi Samkarsa.com • KVM 4';
  description = 'Tinggalkan lisensi mahal Odoo! Self-hosting ERPNext skala perusahaan di Hostinger VPS KVM 4. Nikmati performa NVMe ultra-cepat, snapshot harian otomatis, dan hemat pengeluaran IT hingga 80%.';
  spec = '4 vCPU • 16GB RAM • 200GB NVMe • Bandwidth 4TB • Full Root Access';
  ctaText = 'Deploy ERPNext di VPS KVM 4 Sekarang';
  ctaUrl = 'https://www.hostinger.co.id/vps-hosting?utm_source=bijaktechnology&utm_medium=affiliate&utm_campaign=samkarsa-erpnext';
} else if (catLower.includes('ai') || catLower.includes('tech') || catLower.includes('devops') || catLower.includes('docker') || catLower.includes('coolify')) {
  title = 'Hostinger VPS KVM 2: Playground AI Agent, n8n & Coolify';
  badge = '1-Click Docker • NVMe Turbo';
  description = 'Deploy otomasi n8n, Coolify PaaS, FastAPI, dan PostgreSQL pgvector dalam 1 klik tanpa pusing instalasi server dari awal. Performa komputasi tangguh untuk AI developer modern.';
  spec = '2 vCPU • 8GB RAM • 100GB NVMe Storage • Dedicated IPv4 & IPv6';
  ctaText = 'Deploy Server AI di KVM 2';
  ctaUrl = 'https://www.hostinger.co.id/vps-hosting?utm_source=bijaktechnology&utm_medium=affiliate&utm_campaign=dev-n8n-coolify';
} else if (catLower.includes('blockchain') || catLower.includes('web3') || catLower.includes('avalanche') || catLower.includes('crypto')) {
  title = 'Hostinger Cloud VPS: Node Gateway & Indexer Avalanche L1';
  badge = 'Web3 High-Availability • Low-Latency';
  description = 'Jalankan backend indexer, node RPC Avalanche, dan listener webhook smart contract 24/7 tanpa khawatir downtime dengan latency server terendah di Asia Tenggara.';
  spec = 'High-Speed NVMe Array • DDoS Protection L3/L4 • 99.9% Uptime Guarantee';
  ctaText = 'Deploy Node Avalanche di Hostinger';
  ctaUrl = 'https://www.hostinger.co.id/vps-hosting?utm_source=bijaktechnology&utm_medium=affiliate&utm_campaign=avalanche-web3';
}
---

{variant === 'in-article' ? (
  <aside class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 text-white shadow-xl border border-indigo-500/30 not-prose relative overflow-hidden">
    <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
          {badge}
        </span>
        <span class="text-xs font-mono text-indigo-300/80">
          Kupon: <strong class="text-amber-300 font-bold tracking-wider">BIJAKTECH</strong>
        </span>
      </div>

      <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mb-3">
        {title}
      </h3>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-5">
        {description}
      </p>

      <div class="p-3 rounded-xl bg-white/5 border border-white/10 mb-6 text-xs text-indigo-200 font-mono flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        <span>{spec}</span>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
          href={ctaUrl}
          target="_blank"
          rel="noopener sponsored"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold text-sm tracking-wide shadow-lg shadow-indigo-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>{ctaText}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <span class="text-[11px] text-slate-400 text-center sm:text-left">
          Garansi 30 Hari Uang Kembali • Setup Instan
        </span>
      </div>
    </div>
  </aside>
) : (
  <div class="p-5 rounded-2xl bg-gradient-to-br from-indigo-950 via-slate-900 to-purple-950 text-white border border-indigo-500/30 shadow-lg text-center">
    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 mb-3">
      Hostinger Partner
    </span>
    <h4 class="text-base font-bold text-white mb-2 leading-snug">
      {title}
    </h4>
    <p class="text-xs text-slate-300 leading-relaxed mb-4">
      Gunakan kode kupon <span class="text-amber-300 font-mono font-bold">BIJAKTECH</span> untuk potongan harga ekstra.
    </p>
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener sponsored"
      class="block w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs tracking-wide transition-all shadow-md"
    >
      {ctaText}
    </a>
  </div>
)}
