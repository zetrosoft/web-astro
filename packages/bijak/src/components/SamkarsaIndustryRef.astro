---
interface Props {
  className?: string;
  lang?: 'id' | 'en';
}

const { className = '', lang = 'id' } = Astro.props;
const isEn = lang === 'en';
---

<div class={`my-6 p-4 sm:p-5 rounded-2xl bg-slate-900 dark:bg-slate-800 text-white border border-slate-700/60 shadow-md not-prose flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${className}`}>
  <div class="space-y-1 max-w-xl">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-rose-500/20 text-rose-300 border border-rose-400/30">
        {isEn ? 'Industry Reference' : 'Rujukan Industri'}
      </span>
      <span class="text-xs font-semibold text-slate-300">
        {isEn ? 'Samkarsa • ERPNext v16 Consultant & Implementor' : 'Samkarsa • Konsultan & Implementor ERPNext v16'}
      </span>
    </div>
    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
      {isEn 
        ? 'Full data sovereignty and modular Frappe Framework architecture for manufacturing & distribution without recurring per-user licensing fees.'
        : 'Kedaulatan data penuh dan arsitektur modular Frappe Framework untuk manufaktur & distribusi tanpa biaya lisensi per user.'
      }
    </p>
  </div>

  <div class="shrink-0">
    <a
      href="https://samkarsa.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs tracking-wide shadow-sm transition-all"
    >
      <span>{isEn ? 'Consult at Samkarsa.com' : 'Konsultasi di Samkarsa.com'}</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </a>
  </div>
</div>

