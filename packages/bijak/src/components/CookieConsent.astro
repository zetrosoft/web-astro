---
interface Props {
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;
const isEn = lang === 'en';
---

<!-- Google Consent Mode v2 & Interactive Cookie Banner -->
<div 
  id="cookie-consent-banner" 
  class="fixed bottom-4 left-4 right-4 md:left-6 md:right-auto md:max-w-md z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-2 border-neutral-900 dark:border-neutral-700 p-5 rounded-2xl shadow-2xl transition-all duration-300 transform translate-y-32 opacity-0 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label={isEn ? "Cookie and Privacy Consent" : "Persetujuan Cookie dan Privasi"}
>
  <div class="flex items-start gap-3">
    <div class="p-2 bg-rose-100 dark:bg-rose-950/60 text-rose-600 rounded-xl shrink-0 mt-0.5">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
    </div>
    <div class="space-y-2 text-xs">
      <h3 class="font-bold text-neutral-900 dark:text-neutral-100 uppercase tracking-wide">
        {isEn ? "Privacy & Cookie Policy" : "Privasi & Kebijakan Cookie"}
      </h3>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans">
        {isEn 
          ? "We use cookies to analyze reader traffic, personalize Google AdSense advertisements, and elevate system performance in accordance with our "
          : "Kami menggunakan cookie untuk menganalisis lalu lintas pembaca, mempersonalisasi iklan Google AdSense, dan menjaga keandalan sistem sesuai dengan "
        }
        <a 
          href={isEn ? "/en/privacy-policy/" : "/privacy-policy/"} 
          class="text-rose-600 dark:text-rose-400 font-semibold underline hover:text-rose-700"
        >
          {isEn ? "Privacy Policy" : "Kebijakan Privasi"}
        </a>.
      </p>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2.5 mt-4 pt-3 border-t border-neutral-200 dark:border-neutral-800">
    <button 
      id="btn-reject-cookie" 
      type="button" 
      class="px-3.5 py-1.5 text-xs font-semibold text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-lg transition-colors"
    >
      {isEn ? "Essential Only" : "Hanya Esensial"}
    </button>
    <button 
      id="btn-accept-cookie" 
      type="button" 
      class="px-4 py-1.5 text-xs font-bold bg-neutral-900 dark:bg-rose-600 text-white rounded-lg hover:bg-rose-600 dark:hover:bg-rose-700 transition-colors shadow-sm"
    >
      {isEn ? "Accept All" : "Setujui Semua"}
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const banner = document.getElementById('cookie-consent-banner');
    const btnAccept = document.getElementById('btn-accept-cookie');
    const btnReject = document.getElementById('btn-reject-cookie');

    // Google Consent Mode Default Initializer
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }

    const savedConsent = localStorage.getItem('bijak_cookie_consent');

    if (!savedConsent) {
      setTimeout(() => {
        if (banner) {
          banner.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
        }
      }, 800);
    } else if (savedConsent === 'granted') {
      gtag('consent', 'update', {
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted',
        'analytics_storage': 'granted'
      });
    }

    if (btnAccept && banner) {
      btnAccept.addEventListener('click', () => {
        localStorage.setItem('bijak_cookie_consent', 'granted');
        gtag('consent', 'update', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
        banner.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      });
    }

    if (btnReject && banner) {
      btnReject.addEventListener('click', () => {
        localStorage.setItem('bijak_cookie_consent', 'denied');
        gtag('consent', 'update', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'granted'
        });
        banner.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      });
    }
  })();
</script>
