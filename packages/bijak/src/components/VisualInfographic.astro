---
// packages/bijak/src/components/VisualInfographic.astro
// Komponen Infografis Visual Universal untuk mempercantik halaman dan mempermudah pemahaman pembaca
export interface CardItem {
  title: string;
  badge?: string;
  variant?: 'danger' | 'warning' | 'success' | 'info' | 'primary';
  points: string[];
  metric?: string;
  metricLabel?: string;
}

export interface Props {
  type?: 'comparison' | 'steps' | 'metrics';
  badge?: string;
  title?: string;
  subtitle?: string;
  cards?: CardItem[];
  category?: string;
}

const {
  type = 'comparison',
  badge = 'INFOGRAFIS EKSKLUSIF REDAKSI',
  title = 'Visualisasi Strategis & Arsitektur Solusi',
  subtitle = 'Panduan visual terstruktur untuk memudahkan pemahaman komparasi data, mitigasi risiko, dan eksekusi taktis.',
  cards = [],
  category = ''
} = Astro.props;

// Default fallback cards jika tidak disuplai props eksplisit, berbasis kategori
const defaultCards: CardItem[] = cards.length > 0 ? cards : [
  {
    title: 'Pendekatan Konvensional / Risiko Tinggi',
    badge: '⚠️ METODE RENTAN',
    variant: 'danger',
    metric: '90%',
    metricLabel: 'Tingkat Ketergantungan Eksternal',
    points: [
      'Menyimpan data sensitif pada cloud publik gratisan tanpa enkripsi end-to-end.',
      'Bergantung pada autentikasi SMS OTP yang rawan penyadapan SIM Swap.',
      'Biaya lisensi berulang terus membengkak seiring bertambahnya pengguna.'
    ]
  },
  {
    title: 'Arsitektur Mandiri & Kedaulatan Penuh',
    badge: '🛡️ STANDAR TERVERIFIKASI',
    variant: 'success',
    metric: '99.4%',
    metricLabel: 'Efisiensi Proteksi & Kontrol Aset',
    points: [
      'Penyimpanan terisolasi di private server mandiri (self-hosted vault).',
      'Proteksi berlapis berbasis Hardware Key / Cold Storage terenkripsi.',
      'Eliminasi biaya pihak ketiga dengan penghematan kas jangka panjang.'
    ]
  }
];
---

<div class="my-10 not-prose rounded-3xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden transition-all">
  <!-- Top Header Badge -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white px-6 py-4 flex flex-wrap justify-between items-center gap-3 border-b border-slate-700/60">
    <div class="flex items-center gap-2.5">
      <span class="w-3 h-3 rounded-full bg-rose-500 animate-pulse shadow-sm"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-rose-300">
        {badge}
      </span>
    </div>
    <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-slate-700/60 text-slate-200 border border-slate-600/50 font-semibold">
      📊 VISUAL INSIGHT FRAMEWORK
    </span>
  </div>

  <div class="p-6 sm:p-8">
    <h3 class="text-xl sm:text-2xl font-extrabold text-slate-950 dark:text-white tracking-tight mb-2 text-center">
      {title}
    </h3>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 text-center max-w-2xl mx-auto mb-8 leading-relaxed">
      {subtitle}
    </p>

    <!-- Cards Grid Comparison -->
    <div class={`grid grid-cols-1 ${defaultCards.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-6 items-stretch`}>
      {defaultCards.map((card) => {
        const isDanger = card.variant === 'danger';
        const isSuccess = card.variant === 'success';
        const isWarning = card.variant === 'warning';

        const bgGradient = isDanger 
          ? 'from-rose-50/70 via-amber-50/30 to-white dark:from-rose-950/20 dark:via-slate-900 dark:to-slate-900 border-rose-200/80 dark:border-rose-900/40'
          : isSuccess
          ? 'from-emerald-50/70 via-teal-50/30 to-white dark:from-emerald-950/20 dark:via-slate-900 dark:to-slate-900 border-emerald-200/80 dark:border-emerald-900/40'
          : 'from-slate-50 via-indigo-50/30 to-white dark:from-indigo-950/20 dark:via-slate-900 dark:to-slate-900 border-indigo-200/80 dark:border-indigo-900/40';

        const badgeColor = isDanger
          ? 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border-rose-300 dark:border-rose-800'
          : isSuccess
          ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800'
          : 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-300 border-indigo-300 dark:border-indigo-800';

        return (
          <div class={`rounded-2xl p-6 bg-gradient-to-br ${bgGradient} border flex flex-col justify-between relative overflow-hidden shadow-sm`}>
            <div>
              {card.badge && (
                <div class="mb-4">
                  <span class={`px-2.5 py-1 rounded-lg text-[10px] font-extrabold uppercase tracking-wider border ${badgeColor}`}>
                    {card.badge}
                  </span>
                </div>
              )}

              <h4 class="text-base sm:text-lg font-bold text-slate-950 dark:text-white mb-4 leading-snug">
                {card.title}
              </h4>

              <ul class="space-y-3 text-xs text-slate-700 dark:text-slate-300 font-medium">
                {card.points.map((pt) => (
                  <li class="flex items-start gap-2.5">
                    <span class={isDanger ? 'text-rose-500 font-bold shrink-0 mt-0.5' : 'text-emerald-500 font-bold shrink-0 mt-0.5'}>
                      {isDanger ? '✕' : '✓'}
                    </span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>

            {card.metric && (
              <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 flex items-baseline justify-between">
                <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                  {card.metricLabel || 'Metrik Efektivitas'}
                </span>
                <span class={`text-lg font-extrabold font-mono ${isDanger ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600 dark:text-emerald-400'}`}>
                  {card.metric}
                </span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</div>
