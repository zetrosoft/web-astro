---
interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle';
  layoutKey?: string;
  className?: string;
  minHeight?: string;
}

const {
  slot = '6641645482',
  format = 'auto',
  layoutKey,
  className = '',
  minHeight = '90px'
} = Astro.props;

const client = 'ca-pub-7398988805905629';
const inlineMinHeight = minHeight.includes('min-h-[') ? minHeight.replace('min-h-[', '').replace(']', '') : minHeight;
---

<div class={`adsense-clean-slot my-6 w-full text-center not-prose overflow-hidden flex flex-col items-center justify-center ${className}`}>
  <div class="text-[10px] tracking-widest uppercase font-semibold text-slate-400 dark:text-slate-500 mb-1 opacity-70">
    Iklan
  </div>

  <ins
    class="adsbygoogle"
    style={`display:block; min-height: ${inlineMinHeight};`}
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true"
    {...(layoutKey ? { 'data-ad-layout-key': layoutKey } : {})}
  ></ins>

  <script is:inline>
    try {
      (adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {}
  </script>
</div>
