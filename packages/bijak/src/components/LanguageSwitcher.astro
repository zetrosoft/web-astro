---
// Language Switcher untuk website Bijak
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  currentLang: 'id' | 'en';
}

const { currentLang } = Astro.props;
const oppositeLang = currentLang === 'id' ? 'en' : 'id';
const pathname = Astro.url.pathname;
const cleanPathname = pathname.replace(/^\/en/, '') || '/';
const targetUrl = oppositeLang === 'id' ? cleanPathname : getRelativeLocaleUrl('en', cleanPathname);
---

<a 
  href={targetUrl} 
  class="inline-flex items-center gap-1.5 px-2.5 h-8 text-xs font-bold rounded-lg border border-slate-300 dark:border-slate-600 bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-white transition-all shadow-xs"
  title={currentLang === 'id' ? 'Switch to English' : 'Beralih ke Bahasa Indonesia'}
>
  <span class="text-xs">🌐</span>
  <span class="font-mono uppercase">{oppositeLang}</span>
</a>
