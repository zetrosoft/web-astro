---
interface Props {
  variant?: 'in-article' | 'footer';
  lang?: 'id' | 'en';
  className?: string;
}

const { variant = 'in-article', lang = 'id', className = '' } = Astro.props;
const isEn = lang === 'en';

const badgeText = isEn ? 'Bijak Tech Digest • Weekly Curated' : 'Bijak Tech Digest • Buletin Mingguan';
const titleText = isEn 
  ? 'Get Systems Architecture & DevOps Digest Every Monday' 
  : 'Dapatkan Ringkasan Arsitektur & DevOps Setiap Senin';
const descText = isEn
  ? 'Zero spam, zero fluff. One weekly briefing delivering server benchmarks, real-sector engineering case studies, and practical terminal tips directly to your inbox.'
  : 'Tanpa spam, tanpa clickbait. 1 email mingguan berisi ringkasan performa server, studi kasus sistem sektor riil, dan trik terminal praktis langsung ke inbox Anda.';
const inputPlaceholder = isEn ? 'Enter your work email (e.g. name@company.com)' : 'Masukkan email Anda (misal: nama@perusahaan.com)';
const buttonText = isEn ? 'Subscribe Free' : 'Langganan Gratis';
const privacyNote = isEn 
  ? 'Sent every Monday at 07:00 AM WIB. 1-click unsubscribe anytime.' 
  : 'Terkirim setiap Senin pukul 07:00 WIB. Berhenti berlangganan kapan saja dengan 1 klik.';
---

<div class={`newsletter-box-wrapper not-prose rounded-3xl overflow-hidden transition-all duration-300 ${
  variant === 'footer' 
    ? 'bg-slate-900 dark:bg-slate-950 text-white p-6 sm:p-8 border border-slate-800 shadow-xl' 
    : 'bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 text-white p-6 sm:p-8 my-10 border border-slate-800 shadow-xl'
} ${className}`}>
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-950/80 border border-rose-800/60 text-rose-400 text-[11px] font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        {badgeText}
      </span>
    </div>

    <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight leading-snug mb-2">
      {titleText}
    </h3>

    <p class="text-xs sm:text-sm text-slate-300 dark:text-slate-400 leading-relaxed mb-6 font-normal">
      {descText}
    </p>

    <form class="newsletter-form flex flex-col sm:flex-row gap-2.5" novalidate>
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <input 
          type="email" 
          name="email" 
          required 
          placeholder={inputPlaceholder}
          class="w-full pl-10 pr-4 py-3 bg-slate-800/90 dark:bg-slate-900 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition-all"
        />
      </div>

      <button 
        type="submit" 
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-500 active:bg-rose-700 text-white font-bold text-sm tracking-wide transition-all shadow-md hover:shadow-rose-600/20 shrink-0 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span>{buttonText}</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </form>

    <!-- Feedback Message Box -->
    <div class="newsletter-status text-xs mt-3.5 font-medium hidden"></div>

    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-3 font-normal">
      🔒 {privacyNote}
    </p>
  </div>
</div>

<script is:inline>
  (function() {
    function initNewsletterForms() {
      const forms = document.querySelectorAll('.newsletter-form');
      forms.forEach(form => {
        if (form.getAttribute('data-initialized')) return;
        form.setAttribute('data-initialized', 'true');

        const wrapper = form.closest('.newsletter-box-wrapper');
        const input = form.querySelector('input[name="email"]');
        const submitBtn = form.querySelector('button[type="submit"]');
        const statusBox = wrapper ? wrapper.querySelector('.newsletter-status') : null;

        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          const email = (input?.value || '').trim();

          if (!email || !email.includes('@') || !email.includes('.')) {
            if (statusBox) {
              statusBox.className = 'newsletter-status text-xs mt-3.5 font-semibold text-rose-400 block';
              statusBox.textContent = '⚠️ Masukkan alamat email yang valid.';
            }
            input?.focus();
            return;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.setAttribute('data-original-text', submitBtn.innerHTML);
            submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⏳</span> Mendaftarkan...';
          }
          if (statusBox) statusBox.className = 'newsletter-status hidden';

          try {
            const resp = await fetch('/api/newsletter/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: email,
                source_url: window.location.href,
                referrer: document.referrer || ''
              })
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
              form.style.display = 'none';
              if (statusBox) {
                statusBox.className = 'newsletter-status text-sm mt-3.5 font-semibold text-emerald-400 p-4 rounded-xl bg-emerald-950/40 border border-emerald-800/60 block';
                statusBox.innerHTML = `✅ <strong>Berhasil!</strong> ${data.message || 'Terima kasih telah berlangganan Bijak Tech Digest.'}`;
              }
            } else {
              throw new Error(data.error || 'Gagal mendaftar. Silakan coba lagi.');
            }
          } catch (err) {
            if (statusBox) {
              statusBox.className = 'newsletter-status text-xs mt-3.5 font-semibold text-rose-400 block';
              statusBox.textContent = `⚠️ ${err.message || 'Terjadi kesalahan jaringan. Coba lagi nanti.'}`;
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = submitBtn.getAttribute('data-original-text') || 'Langganan Gratis';
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNewsletterForms);
    } else {
      initNewsletterForms();
    }
  })();
</script>
