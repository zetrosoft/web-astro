---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    slug: 'panduan-implementasi-erpnext-ukm',
    title: 'Panduan Lengkap Implementasi ERPNext untuk UKM Indonesia',
    description: 'ERPNext adalah solusi ERP open-source terbaik untuk UKM Indonesia. Panduan ini membahas langkah-langkah implementasi dari awal hingga go-live.',
    date: '2025-03-15',
    category: 'ERPNext',
    readTime: 8,
  },
  {
    slug: 'erpnext-vs-sap-vs-odoo',
    title: 'ERPNext vs SAP vs Odoo: Mana yang Tepat untuk Bisnis Anda?',
    description: 'Perbandingan mendalam ERPNext, SAP, dan Odoo dari sisi fitur, biaya, dan kesesuaian untuk bisnis Indonesia.',
    date: '2025-02-20',
    category: 'Perbandingan ERP',
    readTime: 6,
  },
];
---

<Layout
  title="Blog — Samkarsa ERP Insights"
  description="Artikel, panduan, dan tips seputar ERPNext, transformasi digital, dan manajemen bisnis untuk perusahaan Indonesia."
>
  <section class="pt-32 pb-20">
    <div class="max-w-5xl mx-auto px-6">
      <!-- Header -->
      <div class="mb-14">
        <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-700 text-sm font-semibold rounded-full mb-4">Blog & Insights</span>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-brand-900 mb-4">
          ERP Knowledge Hub
        </h1>
        <p class="text-slate-500 text-lg max-w-xl leading-relaxed">
          Artikel, panduan, dan tips seputar ERPNext, transformasi digital, dan manajemen bisnis modern.
        </p>
      </div>

      <!-- Posts Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        {posts.map((post) => (
          <article class="group bg-white rounded-2xl border border-slate-100 hover:border-brand-200 shadow-sm hover:shadow-xl overflow-hidden transition-all duration-300 hover:-translate-y-1">
            <!-- Category bar -->
            <div class="h-1.5 bg-gradient-to-r from-brand-600 to-accent-500"></div>

            <div class="p-7">
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 bg-brand-50 text-brand-700 text-xs font-semibold rounded-full">
                  {post.category}
                </span>
                <span class="text-xs text-slate-400">{post.readTime} menit baca</span>
              </div>

              <h2 class="font-heading font-bold text-xl text-brand-900 mb-3 group-hover:text-brand-700 transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>

              <p class="text-slate-500 text-sm leading-relaxed mb-5 line-clamp-3">
                {post.description}
              </p>

              <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <time class="text-xs text-slate-400">
                  {new Date(post.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                >
                  Baca Selengkapnya
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
