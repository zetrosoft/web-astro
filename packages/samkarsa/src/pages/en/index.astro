---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');

const services = [
  {
    icon: '📊',
    title: 'Accounting & Finance',
    desc: 'Real-time financial reporting, budget management, and full audit trail. Compliance with Indonesian accounting standards (PSAK).',
    features: ['General Ledger', 'Profit & Loss Statement', 'Balance Sheet', 'Cash Flow'],
  },
  {
    icon: '🛒',
    title: 'Sales & Procurement',
    desc: 'Manage your entire sales and procurement cycle in one integrated platform.',
    features: ['Sales Order', 'Purchase Order', 'Supplier Management', 'Customer Relationship'],
  },
  {
    icon: '👥',
    title: 'HR & Payroll',
    desc: 'Automate payroll processing, attendance, and employee performance appraisal efficiently.',
    features: ['Auto Payroll', 'Digital Attendance', 'Performance Appraisal', 'Indonesian Tax/BPJS Integration'],
  },
  {
    icon: '📦',
    title: 'Inventory & Warehouse',
    desc: 'Monitor stock in real-time, manage warehouses, and optimize your business supply chain.',
    features: ['Real-time Stock', 'Multi-warehouse', 'FIFO/LIFO', 'Barcode Support'],
  },
  {
    icon: '📈',
    title: 'Business Intelligence',
    desc: 'Integrated analytical dashboards for accurate, data-driven decision making.',
    features: ['Custom Dashboard', 'Ad-hoc Reports', 'KPI Monitoring', 'Data Export'],
  },
  {
    icon: '⚙️',
    title: 'Implementation & Consulting',
    desc: 'Full assistance from requirements analysis, custom configuration, user training, to go-live and post go-live support.',
    features: ['Business Analysis', 'Custom Configuration', 'User Training', 'Post Go-live Support'],
  },
];

const stats = [
  { value: '50+', label: t('stats.client') },
  { value: '8+', label: t('stats.exp') },
  { value: '15+', label: t('stats.modules') },
  { value: '99%', label: t('stats.sat') },
];

const whys = [
  {
    icon: '🏆',
    title: 'Experienced & Certified',
    desc: 'Our team has deep experience implementing ERPNext across various industries in Indonesia.',
  },
  {
    icon: '🔧',
    title: 'Tailored Solutions',
    desc: 'We do not sell generic solutions. Each implementation is customized to match your business processes.',
  },
  {
    icon: '🚀',
    title: 'Rapid Go-Live',
    desc: 'Our structured implementation methodology ensures projects run on-time and on-budget.',
  },
  {
    icon: '💬',
    title: 'Continuous Support',
    desc: 'Technical support and consulting post-implementation to keep system running optimally.',
  },
];
---

<Layout
  title="Samkarsa — ERPNext Consulting & Digital Transformation"
  description="Specialist in ERPNext implementation for Indonesian businesses. Integrated ERP solutions: Accounting, Finance, HR, Payroll, Sales, and Procurement."
  lang="en"
>

  <!-- HERO SECTION -->
  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-800 to-brand-900"></div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>
    <!-- Accent blobs -->
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-0 w-80 h-80 bg-brand-400/20 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-20 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: Text -->
        <div class="animate-fade-up">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-sm text-white/80 font-medium mb-6">
            <span class="w-2 h-2 bg-accent-400 rounded-full animate-pulse"></span>
            {t('hero.badge')}
          </div>

          <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            {t('hero.title1')}
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-accent-300 to-accent-500">
              {t('hero.title2')}
            </span>
          </h1>

          <p class="text-slate-300 text-lg leading-relaxed mb-8 max-w-lg">
            {t('hero.desc')}
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="#kontak" class="inline-flex items-center gap-2 px-7 py-3.5 bg-accent-500 hover:bg-accent-600 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-accent-500/30 hover:shadow-xl hover:-translate-y-0.5">
              {t('nav.cta')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#layanan" class="inline-flex items-center gap-2 px-7 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl border border-white/20 backdrop-blur-sm transition-all duration-200">
              View Services
            </a>
          </div>

          <!-- Trust badges -->
          <div class="flex items-center gap-4 mt-10">
            <div class="flex -space-x-3">
              {[...Array(4)].map((_, i) => (
                <div class={`w-9 h-9 rounded-full border-2 border-brand-800 flex items-center justify-center text-sm font-bold text-white ${i % 2 === 0 ? 'bg-accent-500' : 'bg-brand-500'}`}>
                  {String.fromCharCode(65 + i)}
                </div>
              ))}
            </div>
            <p class="text-sm text-slate-300">
              Trusted by <span class="text-white font-semibold">50+ companies</span> in Indonesia
            </p>
          </div>
        </div>

        <!-- Right: Stats card -->
        <div class="grid grid-cols-2 gap-4 animate-fade-in">
          {stats.map((s) => (
            <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-6 hover:bg-white/15 transition-colors">
              <div class="font-heading text-4xl font-bold text-white mb-1">{s.value}</div>
              <div class="text-slate-400 text-sm">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- LAYANAN SECTION -->
  <section id="layanan" class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-700 text-sm font-semibold rounded-full mb-4">{t('service.badge')}</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-900 mb-4">
          {t('service.title')}
        </h2>
        <p class="text-slate-500 max-w-xl mx-auto leading-relaxed">
          {t('service.desc')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="group bg-white rounded-2xl p-7 border border-slate-100 hover:border-brand-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="text-3xl mb-4">{service.icon}</div>
            <h3 class="font-heading font-bold text-lg text-brand-900 mb-2">{service.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-5">{service.desc}</p>
            <ul class="space-y-1.5">
              {service.features.map((f) => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-accent-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KENAPA KAMI -->
  <section id="kenapa" class="py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-700 text-sm font-semibold rounded-full mb-4">{t('why.badge')}</span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-900 mb-6">
            {t('why.title')}
          </h2>
          <p class="text-slate-500 leading-relaxed mb-8">
            {t('why.desc')}
          </p>

          <div class="grid sm:grid-cols-2 gap-5">
            {whys.map((w) => (
              <div class="flex gap-4">
                <div class="text-2xl flex-shrink-0">{w.icon}</div>
                <div>
                  <h4 class="font-heading font-semibold text-brand-900 mb-1">{w.title}</h4>
                  <p class="text-slate-500 text-sm leading-relaxed">{w.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Visual: Process steps -->
        <div class="relative">
          <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100">
            <h3 class="font-heading font-bold text-brand-900 mb-6">{t('process.title')}</h3>
            <div class="space-y-6">
              {[
                { step: '01', title: t('process.1'), desc: t('process.1.desc') },
                { step: '02', title: t('process.2'), desc: t('process.2.desc') },
                { step: '03', title: t('process.3'), desc: t('process.3.desc') },
                { step: '04', title: t('process.4'), desc: t('process.4.desc') },
                { step: '05', title: t('process.5'), desc: t('process.5.desc') },
              ].map((p, i) => (
                <div class="flex gap-4 items-start">
                  <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-600 to-accent-500 flex items-center justify-center flex-shrink-0">
                    <span class="text-white text-xs font-bold">{p.step}</span>
                  </div>
                  <div class="flex-1 pt-1">
                    <h4 class="font-semibold text-brand-900 text-sm">{p.title}</h4>
                    <p class="text-slate-500 text-xs mt-0.5">{p.desc}</p>
                  </div>
                  {i < 4 && <div class="absolute left-[2.9rem] mt-12 w-0.5 h-5 bg-slate-200"></div>}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / KONTAK -->
  <section id="kontak" class="py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="relative bg-gradient-to-br from-brand-800 to-brand-900 rounded-3xl p-10 md:p-16 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.4) 1px, transparent 0); background-size: 32px 32px;"></div>
        <div class="absolute top-0 right-0 w-64 h-64 bg-accent-500/20 rounded-full blur-3xl"></div>

        <div class="relative">
          <span class="inline-block px-4 py-1.5 bg-white/10 text-white/80 text-sm font-medium rounded-full mb-5 border border-white/20">
            {t('cta.badge')}
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-5">
            {t('cta.title')}
          </h2>
          <p class="text-slate-300 max-w-xl mx-auto leading-relaxed mb-10">
            {t('cta.desc')}
          </p>

          <form class="max-w-lg mx-auto">
            <div class="grid sm:grid-cols-2 gap-4 mb-4">
              <input
                type="text"
                placeholder={t('cta.form.name')}
                class="px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 rounded-xl text-sm focus:outline-none focus:border-accent-400 backdrop-blur-sm transition-colors"
                required
              />
              <input
                type="email"
                placeholder={t('cta.form.email')}
                class="px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 rounded-xl text-sm focus:outline-none focus:border-accent-400 backdrop-blur-sm transition-colors"
                required
              />
            </div>
            <input
              type="text"
              placeholder={t('cta.form.company')}
              class="w-full px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 rounded-xl text-sm focus:outline-none focus:border-accent-400 backdrop-blur-sm transition-colors mb-4"
            />
            <textarea
              placeholder={t('cta.form.message')}
              rows="3"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 rounded-xl text-sm focus:outline-none focus:border-accent-400 backdrop-blur-sm transition-colors mb-4 resize-none"
            ></textarea>
            <button
              type="submit"
              class="w-full py-4 bg-accent-500 hover:bg-accent-600 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-accent-500/30 hover:shadow-xl hover:-translate-y-0.5 text-sm"
            >
              {t('cta.form.submit')}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>
