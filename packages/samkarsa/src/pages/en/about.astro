---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="About Samkarsa — ERP Specialist & Software Architect"
  description="Samkarsa is a consultancy brand powered by Zetrosoft, an ERP specialist and software architect with 8+ years experience guiding Indonesian business digital transformation."
  lang="en"
>

  <!-- Hero About -->
  <section class="pt-32 pb-20 bg-gradient-to-b from-brand-50 to-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="animate-fade-up">
          <span class="inline-block px-4 py-1.5 bg-brand-100 text-brand-700 text-sm font-semibold rounded-full mb-5">About Us</span>
          <h1 class="font-heading text-4xl md:text-5xl font-bold text-brand-900 leading-tight mb-6">
            Software Architect &
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-accent-500"> ERP Specialist</span>
          </h1>
          <p class="text-slate-600 leading-relaxed mb-6">
            <strong>Samkarsa</strong> is an ERP consulting platform founded by <strong>Zetrosoft</strong> — a software architect and ERP specialist with over 8 years of experience helping Indonesian businesses transform digitally.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8">
            We believe every business deserves a powerful management system without sacrificing simplicity. ERPNext is our answer — open-source, highly flexible, and deeply integrated.
          </p>
          <div class="flex gap-4">
            <a href="/en/#kontak" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl transition-all shadow-md hover:-translate-y-0.5">
              Get Consultation
            </a>
            <a href="https://github.com/zetrosoft" target="_blank" class="px-6 py-3 border border-slate-200 text-slate-700 hover:border-brand-300 hover:text-brand-600 font-semibold rounded-xl transition-all">
              GitHub
            </a>
          </div>
        </div>

        <!-- Profile card -->
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100">
          <div class="flex items-center gap-5 mb-6 pb-6 border-b border-slate-100">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-600 to-accent-500 flex items-center justify-center shadow-lg flex-shrink-0">
              <span class="text-white text-2xl font-bold font-heading">Z</span>
            </div>
            <div>
              <h3 class="font-heading font-bold text-brand-900 text-lg">Zetrosoft</h3>
              <p class="text-slate-500 text-sm">Software Architect & ERP Specialist</p>
              <p class="text-slate-400 text-xs mt-0.5">Indonesia 🇮🇩</p>
            </div>
          </div>

          <div class="space-y-4">
            {[
              { label: 'Specialization', value: 'ERPNext, Web3, AI Development' },
              { label: 'Experience', value: '8+ Years' },
              { label: 'Clients', value: '50+ Companies' },
              { label: 'Tech Stack', value: 'Python, JavaScript, ERPNext, Frappe' },
            ].map((item) => (
              <div class="flex justify-between items-start gap-4">
                <span class="text-sm text-slate-500 flex-shrink-0">{item.label}</span>
                <span class="text-sm font-medium text-brand-900 text-right">{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="font-heading text-3xl font-bold text-brand-900 text-center mb-12">Our Core Values</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          {
            icon: '🎯',
            title: 'Results-Oriented',
            desc: 'Every implementation is measured by real results experienced by your business, not just installed software.',
          },
          {
            icon: '🤝',
            title: 'Long-term Partnership',
            desc: 'We are not a transactional vendor. We are a partner that grows alongside your business.',
          },
          {
            icon: '🔍',
            title: 'Full Transparency',
            desc: 'No hidden costs, no false promises. We are always honest about what can and cannot be done.',
          },
        ].map((v) => (
          <div class="text-center p-8 rounded-2xl bg-slate-50 hover:bg-brand-50 transition-colors border border-transparent hover:border-brand-100">
            <div class="text-4xl mb-4">{v.icon}</div>
            <h3 class="font-heading font-bold text-brand-900 mb-2">{v.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-50">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-heading text-3xl font-bold text-brand-900 mb-4">Ready to Collaborate?</h2>
      <p class="text-slate-600 mb-8 leading-relaxed">Tell us about your business challenges and let us construct the right ERP solution.</p>
      <a href="/en/#kontak" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl transition-all shadow-lg hover:-translate-y-0.5">
        Contact Us
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</Layout>
