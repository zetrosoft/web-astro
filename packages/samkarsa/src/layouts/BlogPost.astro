---
import Layout from './Layout.astro';

interface Props {
  content?: {
    title?: string;
    description?: string;
    date?: string;
    category?: string;
    readTime?: number;
    author?: string;
    authorRole?: string;
    ogImage?: string;
    tags?: string[];
  };
  frontmatter?: {
    title?: string;
    description?: string;
    date?: string;
    category?: string;
    readTime?: number;
    author?: string;
    authorRole?: string;
    ogImage?: string;
    tags?: string[];
  };
}

const data = Astro.props.frontmatter || Astro.props.content || {};
const {
  title = 'Artikel Blog Samkarsa',
  description = 'Wawasan teknis dan panduan implementasi ERP modern untuk bisnis Indonesia.',
  date = '2026-08-31',
  category = 'ERP & Arsitektur',
  readTime = 6,
  author = 'Tim Konsultan Samkarsa',
  authorRole = 'Senior ERP & Software Architect',
  ogImage = '/og-default.png',
  tags = ['ERPNext', 'Transformasi Digital', 'Arsitektur Sistem'],
} = data;

const canonicalUrl = new URL(Astro.url.pathname, 'https://samkarsa.com').href;
const formattedDate = new Date(date).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// JSON-LD Schema.org Data for SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "image": new URL(ogImage, 'https://samkarsa.com').href,
  "datePublished": new Date(date).toISOString(),
  "dateModified": new Date().toISOString(),
  "author": {
    "@type": "Person",
    "name": author,
    "jobTitle": authorRole,
    "worksFor": {
      "@type": "Organization",
      "name": "Samkarsa",
      "url": "https://samkarsa.com"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Samkarsa",
    "url": "https://samkarsa.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://samkarsa.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "keywords": tags.join(', ')
};
---

<Layout title={`${title} — Samkarsa Knowledge Hub`} description={description} ogImage={ogImage}>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Reading Progress Bar -->
  <div id="progress-container" class="fixed top-0 left-0 w-full h-1 z-50 bg-slate-100 dark:bg-slate-800">
    <div id="progress-bar" class="h-full bg-gradient-to-r from-brand-600 via-brand-500 to-accent-500 w-0 transition-all duration-75"></div>
  </div>

  <article class="pt-28 md:pt-36 pb-24 min-h-screen bg-slate-50/50 dark:bg-slate-950 transition-colors duration-300">
    <!-- Hero Header -->
    <header class="max-w-6xl mx-auto px-6 mb-12">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6 uppercase tracking-wider">
        <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <a href="/blog" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Blog</a>
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span class="text-brand-600 dark:text-brand-400 truncate max-w-xs">{category}</span>
      </nav>

      <!-- Category & Meta Badges -->
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60 text-xs font-bold uppercase tracking-wider rounded-full shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-600 dark:bg-brand-400 animate-pulse"></span>
          {category}
        </span>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          {readTime} menit baca
        </span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <time datetime={date} class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {formattedDate}
        </time>
      </div>

      <!-- Main Headline -->
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white leading-[1.2] tracking-tight mb-6 max-w-4xl">
        {title}
      </h1>

      <!-- Executive Summary Lead Box -->
      <div class="p-5 md:p-6 bg-white dark:bg-slate-900 border-l-4 border-brand-600 dark:border-accent-500 rounded-r-2xl shadow-xs border border-slate-200/80 dark:border-slate-800 max-w-4xl">
        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-medium m-0">
          <span class="font-bold text-slate-900 dark:text-white">Ringkasan Eksekutif: </span>
          {description}
        </p>
      </div>
    </header>

    <!-- Main Content Container with Sticky Sidebar -->
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left: Article Content Body -->
        <main class="lg:col-span-8">
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-10 md:p-12 border border-slate-200/80 dark:border-slate-800 shadow-sm transition-colors duration-300">
            
            <!-- Article Body (Markdown Prose) -->
            <div id="article-body" class="prose prose-slate prose-lg dark:prose-invert max-w-none
              prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white
              prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-100 dark:prose-h2:border-slate-800
              prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
              prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-p:mb-5
              prose-li:text-slate-700 dark:prose-li:text-slate-300
              prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
              prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-bold
              prose-code:text-brand-700 dark:prose-code:text-accent-300 prose-code:bg-brand-50 dark:prose-code:bg-brand-950/60 prose-code:px-2 prose-code:py-0.5 prose-code:rounded-md prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
              prose-blockquote:border-l-4 prose-blockquote:border-brand-500 prose-blockquote:bg-brand-50/50 dark:prose-blockquote:bg-slate-800/40 prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:italic prose-blockquote:text-slate-700 dark:prose-blockquote:text-slate-300
              prose-table:w-full prose-table:border-collapse prose-table:my-6 prose-table:text-sm
              prose-th:bg-slate-100 dark:prose-th:bg-slate-800 prose-th:p-3 prose-th:text-left prose-th:font-bold prose-th:text-slate-900 dark:prose-th:text-white prose-th:border prose-th:border-slate-200 dark:prose-th:border-slate-700
              prose-td:p-3 prose-td:border prose-td:border-slate-200 dark:prose-td:border-slate-800 prose-td:text-slate-700 dark:prose-td:text-slate-300">
              <slot />
            </div>

            <!-- In-Article Mid/Bottom Conversion Callout -->
            <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-brand-900 to-slate-900 text-white relative overflow-hidden shadow-lg">
              <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-brand-500/10 rounded-full blur-2xl"></div>
              <div class="relative z-10">
                <span class="px-3 py-1 bg-accent-500/20 text-accent-300 text-xs font-bold uppercase tracking-wider rounded-full">
                  Solusi Terintegrasi
                </span>
                <h3 class="font-heading text-xl sm:text-2xl font-bold mt-3 mb-2 text-white">
                  Ingin Menerapkan Arsitektur ERP yang Tepat untuk Perusahaan Anda?
                </h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-6 max-w-xl">
                  Diskusikan kebutuhan alur kerja, integrasi akuntansi PSAK, dan otomatisasi operasional bersama tim konsultan senior kami.
                </p>
                <div class="flex flex-wrap items-center gap-4">
                  <a href="/#kontak" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm rounded-xl shadow-md transition-all hover:shadow-lg hover:-translate-y-0.5">
                    Konsultasi Kebutuhan ERP
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                  <a href="/about" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">
                    Pelajari Portofolio Kami →
                  </a>
                </div>
              </div>
            </div>

            <!-- Author Bio Card -->
            <div class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-600 to-accent-500 flex items-center justify-center text-white font-bold font-heading text-xl shadow-sm shrink-0">
                {author.charAt(0)}
              </div>
              <div class="flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="font-heading font-bold text-base text-slate-900 dark:text-white">{author}</h4>
                  <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
                    {authorRole}
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                  Praktisi implementasi ERPNext dan arsitektur enterprise dengan fokus pada efisiensi operasional, kepatuhan finansial, dan skalabilitas data bisnis.
                </p>
              </div>
            </div>

            <!-- Social Sharing & Return Navigation -->
            <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
              <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Kembali ke Arsip Blog
              </a>

              <!-- Share Buttons -->
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
                <span>Bagikan:</span>
                <button
                  id="share-wa"
                  class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-green-50 dark:hover:bg-green-950/40 hover:text-green-600 transition-colors"
                  aria-label="Bagikan ke WhatsApp"
                  title="WhatsApp"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
                </button>
                <button
                  id="share-li"
                  class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 transition-colors"
                  aria-label="Bagikan ke LinkedIn"
                  title="LinkedIn"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </button>
                <button
                  id="copy-link"
                  class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/40 hover:text-brand-600 transition-colors"
                  aria-label="Salin Tautan"
                  title="Salin Tautan"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
            </div>

          </div>
        </main>

        <!-- Right: Sticky Sidebar (TOC & Lead Generation) -->
        <aside class="lg:col-span-4 space-y-8">
          <div class="sticky top-28 space-y-8">
            
            <!-- Table of Contents (TOC) Box -->
            <div id="toc-card" class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-xs">
              <h3 class="font-heading font-bold text-sm uppercase tracking-wider text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                Daftar Isi Artikel
              </h3>
              <nav id="toc-list" class="space-y-1.5 text-sm text-slate-600 dark:text-slate-400 max-h-[350px] overflow-y-auto pr-2">
                <!-- Javascript will auto-populate headings here -->
              </nav>
            </div>

            <!-- Conversion Card / CTA Widget -->
            <div class="rounded-2xl p-6 bg-gradient-to-br from-brand-600 to-brand-800 text-white shadow-md relative overflow-hidden">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center mb-4">
                <span class="font-bold text-sm">💡</span>
              </div>
              <h4 class="font-heading font-bold text-lg mb-2 text-white">Konsultasi ERP Gratis</h4>
              <p class="text-xs text-brand-100 leading-relaxed mb-5">
                Hindari risiko kegagalan implementasi software. Dapatkan audit kebutuhan proses bisnis Anda langsung dari praktisi kami.
              </p>
              <a
                href="/#kontak"
                class="block w-full py-2.5 px-4 bg-white hover:bg-slate-50 text-brand-800 font-bold text-center text-xs rounded-xl shadow-xs transition-all hover:shadow hover:-translate-y-0.5"
              >
                Minta Jadwal Diskusi →
              </a>
            </div>

            <!-- Trust / Expertise Highlight -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 space-y-3">
              <div class="flex items-center gap-2 font-semibold text-slate-800 dark:text-slate-200">
                <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Standar Industri & Kepatuhan
              </div>
              <p>Mendukung standar akuntansi PSAK, integrasi pajak e-Faktur/PPh 21, BPJS, dan kontrol multi-cabang terpusat.</p>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </article>

  <!-- Client Script for Interactive Features: TOC, Reading Progress, and Sharing -->
  <script is:inline>
    // 1. Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('progress-bar');
      if (bar) bar.style.width = scrolled + '%';
    });

    // 2. Auto-generate Dynamic TOC from H2 and H3 elements
    document.addEventListener('DOMContentLoaded', () => {
      const articleBody = document.getElementById('article-body');
      const tocList = document.getElementById('toc-list');
      const tocCard = document.getElementById('toc-card');

      if (articleBody && tocList) {
        const headings = articleBody.querySelectorAll('h2, h3');
        if (headings.length === 0) {
          if (tocCard) tocCard.style.display = 'none';
          return;
        }

        headings.forEach((heading, idx) => {
          if (!heading.id) {
            heading.id = 'section-' + idx;
          }

          const link = document.createElement('a');
          link.href = '#' + heading.id;
          link.textContent = heading.textContent;
          link.className = heading.tagName === 'H2' 
            ? 'block py-1 font-medium hover:text-brand-600 dark:hover:text-brand-400 transition-colors' 
            : 'block py-0.5 pl-4 text-xs text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors';

          tocList.appendChild(link);
        });
      }

      // 3. Social Sharing Buttons
      const shareUrl = encodeURIComponent(window.location.href);
      const shareTitle = encodeURIComponent(document.title);

      const waBtn = document.getElementById('share-wa');
      if (waBtn) {
        waBtn.addEventListener('click', () => {
          window.open(`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`, '_blank');
        });
      }

      const liBtn = document.getElementById('share-li');
      if (liBtn) {
        liBtn.addEventListener('click', () => {
          window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, '_blank');
        });
      }

      const copyBtn = document.getElementById('copy-link');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-xs text-green-600 font-bold">Tersalin!</span>';
          setTimeout(() => { copyBtn.innerHTML = original; }, 2000);
        });
      }
    });
  </script>
</Layout>
