FROM node:20-alpine AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/bijak/package.json ./packages/bijak/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy package source code
COPY packages/bijak ./packages/bijak

# Build static output for bijak technology
RUN pnpm --filter @web/bijak build

# Production stage using Nginx
FROM nginx:alpine AS runner
COPY --from=builder /app/packages/bijak/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
