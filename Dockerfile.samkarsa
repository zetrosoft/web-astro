FROM node:20-alpine AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/samkarsa/package.json ./packages/samkarsa/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy package source code
COPY packages/samkarsa ./packages/samkarsa

# Build static output for samkarsa
RUN pnpm --filter @web/samkarsa build

# Production stage using Nginx
FROM nginx:alpine AS runner
COPY --from=builder /app/packages/samkarsa/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
